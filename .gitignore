# raw survey data: never commit (this repo is public)
analysis/data/
*.sav
analysis/**/*.csv
# ...except the hand ratings of the modality scripts (party x drug, no respondent data)
!analysis/ratings/*.csv
# fitted model objects contain the respondent-level data they were fitted on
*.rds

# exploratory output (regenerate with the scripts in analysis/R/exploratory/)
analysis/output/

# rendered reports and knitr caches (render locally)
analysis/reports/**/*.html
analysis/reports/**/*_cache/
analysis/reports/**/*_files/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf

# LaTeX build files (the paper is compiled on Overleaf)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
main.pdf

# Office lock files
~$*
