{"SurveyEntry": {"SurveyID": "SV_73amD37tHZ2Qe9w", "SurveyName": "Attitudeonderzoek 2026", "SurveyDescription": null, "SurveyOwnerID": "UR_1zx96MzQSykevWe", "SurveyBrandID": "uva", "DivisionID": "DV_2g9pK71JDa4rVYx", "SurveyLanguage": "NL", "SurveyActiveResponseSet": "RS_51nFrSpZ2yiSncO", "SurveyStatus": "Active", "SurveyStartDate": "0000-00-00 00:00:00", "SurveyExpirationDate": "0000-00-00 00:00:00", "SurveyCreationDate": "2026-07-08 11:17:07", "CreatorID": "UR_1zx96MzQSykevWe", "LastModified": "2026-10-05 06:57:46", "LastAccessed": "0000-00-00 00:00:00", "LastActivated": "2026-07-20 05:46:00", "Deleted": null}, "SurveyElements": [{"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "BL", "PrimaryAttribute": "Survey Blocks", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"0": {"Type": "Default", "SubType": "", "Description": "Introductie & toestemming", "ID": "BL_TVR0IcYfqr8KiIu", "BlockElements": [{"Type": "Page Break"}, {"Type": "Question", "QuestionID": "QID2"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded"}}, "1": {"Type": "Standard", "SubType": "", "Description": "Deel 1: Drugsbeleid", "ID": "BL_vfKRMVTHvfN8vAp", "BlockElements": [{"Type": "Question", "QuestionID": "QID34"}, {"Type": "Page Break"}, {"Type": "Question", "QuestionID": "QID4"}, {"Type": "Question", "QuestionID": "QID47"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded"}}, "2": {"Type": "Standard", "SubType": "", "Description": "Deel 2: Opvattingen (Beliefs)", "ID": "BL_rMf9QqwUCQGJPQW", "BlockElements": [{"Type": "Question", "QuestionID": "QID5"}, {"Type": "Question", "QuestionID": "QID6"}, {"Type": "Question", "QuestionID": "QID41"}, {"Type": "Question", "QuestionID": "QID42"}, {"Type": "Question", "QuestionID": "QID43"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "Advanced", "BlockVisibility": "Expanded", "Randomization": {"Advanced": {"FixedOrder": ["QID5", "{~Randomized~}", "{~Randomized~}", "{~Randomized~}", "{~Randomized~}"], "RandomizeAll": ["QID6", "QID41", "QID42", "QID43"], "RandomSubSet": [], "Undisplayed": [], "TotalRandSubset": 0, "QuestionsPerPage": 0}, "EvenPresentation": false}}}, "3": {"Type": "Standard", "SubType": "", "Description": "Deel 3: Gedrag (Behaviours)", "ID": "BL_9cJfPYSBh92azGE", "BlockElements": [{"Type": "Question", "QuestionID": "QID8"}, {"Type": "Page Break"}, {"Type": "Question", "QuestionID": "QID10"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded"}}, "4": {"Type": "Standard", "SubType": "", "Description": "Deel 4: Gevoelens (Feelings)", "ID": "BL_Ox2Jxtfer0M2yMX", "BlockElements": [{"Type": "Question", "QuestionID": "QID28"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded", "Looping": "None", "LoopingOptions": null}}, "5": {"Type": "Standard", "SubType": "", "Description": "Deel 5: Betrokkenheid", "ID": "BL_PnValntO7taFUzS", "BlockElements": [{"Type": "Question", "QuestionID": "QID16"}, {"Type": "Question", "QuestionID": "QID17"}, {"Type": "Question", "QuestionID": "QID46"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded"}}, "8": {"Type": "Trash", "Description": "Trash / Unused Questions", "ID": "BL_HhWNQQWfEL521ug", "BlockElements": [{"Type": "Question", "QuestionID": "QID18"}, {"Type": "Question", "QuestionID": "QID19"}, {"Type": "Question", "QuestionID": "QID44"}, {"Type": "Question", "QuestionID": "QID20"}, {"Type": "Question", "QuestionID": "QID21"}, {"Type": "Question", "QuestionID": "QID22"}, {"Type": "Question", "QuestionID": "QID37"}, {"Type": "Question", "QuestionID": "QID35"}, {"Type": "Question", "QuestionID": "QID36"}, {"Type": "Question", "QuestionID": "QID3"}, {"Type": "Question", "QuestionID": "QID39"}, {"Type": "Question", "QuestionID": "QID40"}, {"Type": "Question", "QuestionID": "QID38"}, {"Type": "Question", "QuestionID": "QID14"}, {"Type": "Question", "QuestionID": "QID7"}, {"Type": "Question", "QuestionID": "QID9"}, {"Type": "Question", "QuestionID": "QID31"}, {"Type": "Question", "QuestionID": "QID1"}, {"Type": "Question", "QuestionID": "QID45"}], "Options": {"BlockLocking": "false", "RandomizeQuestions": "false", "BlockVisibility": "Expanded"}}}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "FL", "PrimaryAttribute": "Survey Flow", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"Type": "Root", "FlowID": "FL_1", "Flow": [{"Type": "Block", "ID": "BL_TVR0IcYfqr8KiIu", "FlowID": "FL_2", "Autofill": []}, {"Type": "Branch", "FlowID": "FL_13", "Description": "New Branch", "BranchLogic": {"0": {"0": {"LogicType": "Question", "QuestionID": "QID2", "QuestionIsInLoop": "no", "ChoiceLocator": "q://QID2/SelectableChoice/2", "Operator": "Selected", "QuestionIDFromLocator": "QID2", "LeftOperand": "q://QID2/SelectableChoice/2", "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span> <span class=\"QuestionDesc\">Ik ben 16 jaar of ouder, heb de bovenstaande informatie gelezen en geef vrijwillig toestemming om...</span> <span class=\"LeftOpDesc\">Nee, ik wil niet deelnemen</span> <span class=\"OpDesc\">Is Selected</span> "}, "Type": "If"}, "Type": "BooleanExpression"}, "Flow": [{"Type": "EndSurvey", "FlowID": "FL_14", "EndingType": "Advanced", "Options": {"Advanced": "true", "SurveyTermination": "Redirect", "EOSRedirectURL": "https://app.prolific.com/submissions/complete?cc=C1IT2KOR", "AnonymizeResponse": "Yes"}}]}, {"Type": "EmbeddedData", "FlowID": "FL_12", "EmbeddedData": [{"Description": "PROLIFIC_PID", "Type": "Recipient", "Field": "PROLIFIC_PID", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false}]}, {"Type": "EmbeddedData", "FlowID": "FL_10", "EmbeddedData": [{"Description": "Q_Language", "Type": "Recipient", "Field": "Q_Language", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false}]}, {"Type": "Block", "ID": "BL_vfKRMVTHvfN8vAp", "FlowID": "FL_3", "Autofill": []}, {"Type": "Block", "ID": "BL_rMf9QqwUCQGJPQW", "FlowID": "FL_4", "Autofill": []}, {"Type": "Block", "ID": "BL_9cJfPYSBh92azGE", "FlowID": "FL_5", "Autofill": []}, {"Type": "Block", "ID": "BL_Ox2Jxtfer0M2yMX", "FlowID": "FL_6", "Autofill": []}, {"Type": "Block", "ID": "BL_PnValntO7taFUzS", "FlowID": "FL_7", "Autofill": []}, {"Type": "EndSurvey", "FlowID": "FL_15", "EndingType": "Advanced", "Options": {"Advanced": "true", "SurveyTermination": "Redirect", "EOSRedirectURL": "https://app.prolific.com/submissions/complete?cc=C10AW8ET"}}], "Properties": {"Count": 15}}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "PL", "PrimaryAttribute": "Preview Link", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"PreviewType": "Brand", "PreviewID": "ab91a050-d455-4365-8a12-31f16c8bc6ca"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "PROJ", "PrimaryAttribute": "CORE", "SecondaryAttribute": null, "TertiaryAttribute": "1.1.0", "Payload": {"ProjectCategory": "CORE", "SchemaVersion": "1.1.0"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "QC", "PrimaryAttribute": "Survey Question Count", "SecondaryAttribute": "47", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "RS", "PrimaryAttribute": "RS_51nFrSpZ2yiSncO", "SecondaryAttribute": "Standaard antwoordenset", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SCO", "PrimaryAttribute": "Scoring", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"ScoringCategories": [], "ScoringCategoryGroups": [], "ScoringSummaryCategory": null, "ScoringSummaryAfterQuestions": 0, "ScoringSummaryAfterSurvey": 0, "DefaultScoringCategory": null, "AutoScoringCategory": null}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SO", "PrimaryAttribute": "Survey Options", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"BackButton": "true", "SaveAndContinue": "true", "SurveyProtection": "PublicSurvey", "BallotBoxStuffingPrevention": "false", "NoIndex": "Yes", "SecureResponseFiles": "true", "SurveyExpiration": "None", "SurveyTermination": "DefaultMessage", "Header": "", "Footer": "", "ProgressBarDisplay": "NoText", "PartialData": "+1 week", "ValidationMessage": null, "PreviousButton": " ← ", "NextButton": " → ", "SkinLibrary": "uva", "SkinType": "templated", "Skin": {"brandingId": "3067498872", "templateId": "*base", "overrides": null}, "NewScoring": 1, "SurveyTitle": "Drugsattitude onderzoek", "SurveyMetaDescription": "Wat betekenen drugs en drugsbeleid voor jou?", "AvailableLanguages": {"NL": []}, "HiddenLanguages": ["PT-BR", "EN-GB", "FR", "DE", "IT", "PT", "ES-ES", "ES"], "CustomLanguages": [], "EOSMessage": null, "ShowExportTags": "false", "CollectGeoLocation": "false", "PasswordProtection": "No", "AnonymizeResponse": "Yes", "RefererCheck": "No", "BallotBoxStuffingPreventionBehavior": null, "BallotBoxStuffingPreventionMessage": null, "BallotBoxStuffingPreventionMessageLibrary": null, "BallotBoxStuffingPreventionURL": null, "RecaptchaV3": "true", "ConfirmStart": false, "AutoConfirmStart": false, "RelevantID": "false", "RelevantIDLockoutPeriod": "+30 days", "UseCustomSurveyLinkCompletedMessage": null, "SurveyLinkCompletedMessage": null, "SurveyLinkCompletedMessageLibrary": null, "ResponseSummary": "No", "EOSMessageLibrary": null, "EOSRedirectURL": null, "EmailThankYou": "false", "ThankYouEmailMessageLibrary": null, "ThankYouEmailMessage": null, "ValidateMessage": "false", "ValidationMessageLibrary": null, "InactiveSurvey": "DefaultMessage", "PartialDeletion": null, "PartialDataCloseAfter": "LastActivity", "InactiveMessageLibrary": null, "InactiveMessage": null, "ProtectSelectionIds": true, "MetaDataTranslations": {"EN-GB": {"SurveyTitle": "Drug attitude survey", "SurveyMetaDescription": "This survey hopes to gain insight into how Europeans relate to drugs and drug legalisation"}, "IT": {"SurveyTitle": "Indagine sugli atteggiamenti verso le droghe", "SurveyMetaDescription": "Questa indagine spera di capire meglio come gli europei si rapportano alle droghe e alla loro legalizzazione"}, "FR": {"SurveyTitle": "Enquête sur les attitudes envers les drogues", "SurveyMetaDescription": "Cette enquête espère mieux comprendre comment les Européens se positionnent vis-à-vis des drogues et de leur légalisation"}, "PT-BR": {"SurveyTitle": "Pesquisa sobre atitudes em relação às drogas", "SurveyMetaDescription": "Esta pesquisa espera obter informações sobre como os europeus se posicionam em relação às drogas e à sua legalização"}, "DE": {"SurveyTitle": "Umfrage zu Einstellungen gegenüber Drogen", "SurveyMetaDescription": "Diese Umfrage soll Einblick geben, wie Europäer zu Drogen und deren Legalisierung stehen"}, "PT": {"SurveyTitle": "Questionário sobre atitudes em relação às drogas", "SurveyMetaDescription": "Este questionário espera obter informações sobre como os europeus se posicionam em relação às drogas e à sua legalização"}, "ES-ES": {"SurveyTitle": "Encuesta sobre actitudes hacia las drogas", "SurveyMetaDescription": "Esta encuesta espera obtener información sobre cómo los europeos se posicionan frente a las drogas y su legalización"}, "ES": {"SurveyTitle": "Encuesta sobre actitudes hacia las drogas", "SurveyMetaDescription": "Esta encuesta espera obtener información sobre cómo los europeos se posicionan frente a las drogas y su legalización"}}, "CustomStyles": {"customCSS": "/* ==========================================================================\n   POLICY SLIDER QUESTIONS\n   QID34 = practice sliders (2 items), QID4 = main sliders (9 items).\n   Both use the same layout, so every rule is written for both IDs.\n   Paired with per-question JavaScript that draws the ticks and pins the\n   axis to the top of the screen while scrolling.\n   ========================================================================== */\n\n\n/* ---------- DESKTOP (≥641px) ---------- */\n@media (min-width: 641px) {\n\n  /* Reserve a right-hand gutter, equally on the axis and on each slider row,\n     so the bars stay aligned with the axis labels above them.\n     Both elements need the same padding or the alignment drifts. */\n  #QID4 .labels-container,\n  #QID34 .labels-container {\n    padding-right: 140px;\n    box-sizing: border-box;\n  }\n  #QID4 .slider-container,\n  #QID34 .slider-container {\n    position: relative;      /* anchor for the absolutely placed checkbox */\n    padding-right: 140px;\n    box-sizing: border-box;\n  }\n\n  /* Category name (drug) back onto its own line above the bar */\n  #QID4 .statement-container,\n  #QID34 .statement-container {\n    position: static;\n    display: block;\n  }\n\n  /* Park \"Geen mening\" in the reserved gutter, beside the bar */\n  #QID4 .n-a-container,\n  #QID34 .n-a-container {\n    position: absolute;\n    right: 0;\n    bottom: 4px;             /* tweak 0–8px to line up with the bar */\n    height: 30px;\n    display: flex;\n    align-items: center;\n    margin: 0;\n    white-space: nowrap;\n  }\n\n}\n\n\n/* ---------- MOBILE (≤640px) ---------- */\n@media (max-width: 640px) {\n\n  /* Stack the row vertically so \"Geen mening\" can sit below the bar\n     instead of being pushed off the right edge of the screen. */\n  #QID4 .slider-container,\n  #QID34 .slider-container {\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* display:contents lets the category name join the flex ordering\n     as if the wrapper were not there */\n  #QID4 .statement-container,\n  #QID34 .statement-container { display: contents; }\n\n  #QID4 .statement,\n  #QID34 .statement { order: 1; }        /* category name first */\n\n  #QID4 table.sliderGrid,\n  #QID34 table.sliderGrid { order: 2; }  /* then the bar */\n\n  #QID4 .n-a-container,\n  #QID34 .n-a-container {                /* then the checkbox */\n    order: 3;\n    display: flex;\n    align-items: center;\n    align-self: flex-start;              /* starts at the left edge */\n    margin: 10px 0 0 0;\n    white-space: nowrap;\n  }\n\n  /* Nothing may exceed the viewport width (no horizontal scrolling) */\n  #QID4 .horizontalbar,\n  #QID4 .labels-container,\n  #QID4 .slider-container,\n  #QID4 table.sliderGrid,\n  #QID34 .horizontalbar,\n  #QID34 .labels-container,\n  #QID34 .slider-container,\n  #QID34 table.sliderGrid {\n    max-width: 100%;\n    box-sizing: border-box;\n  }\n}\n\n\n/* ---------- AXIS: ALL SCREEN SIZES ---------- */\n\n/* Hide the numeric scale (0, 17, 33 …); the word labels carry the meaning.\n   The values are still recorded in the data. */\n#QID4 .labels-container ul.numbers,\n#QID34 .labels-container ul.numbers {\n  display: none;\n}\n\n\n/* ---------- BELIEF MATRICES ---------- */\n\n/* Blank question stems: the instruction appears once above the first block,\n   so the repeated stem would be redundant. JavaScript on each question hides\n   the element; these rules are the fallback. */\n#QID10 .QuestionText,\n#QID11 .QuestionText,\n#QID12 .QuestionText,\n#QID13 .QuestionText {\n  display: none;\n}"}}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID1", "SecondaryAttribute": "Welkom & informed consent   Bedankt voor je deelname aan dit onderzoek van de Universiteit van Am..", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Welkom &amp; informed consent</h3>\n&nbsp;\n\n<p>Bedankt voor je deelname aan dit onderzoek van de Universiteit van Amsterdam. Deze vragenlijst gaat over hoe mensen in Nederland tegenover drugs en het drugsbeleid staan, wat ze ervan vinden en hoe ze zich hiernaar gedragen. Invullen duurt ongeveer&nbsp;<b>10-&nbsp;15 minuten</b>.</p>\n\n<p>&nbsp;</p>\n\n<p><b>Vrijwillig &amp; anoniem.</b>&nbsp;Deelname is volledig vrijwillig. Je kunt op elk moment stoppen zonder opgaaf van reden door het venster te sluiten; je antwoorden worden dan niet gebruikt. De vragenlijst is anoniem: we vragen geen naam, adres of andere direct herleidbare gegevens. Antwoorden worden vertrouwelijk en uitsluitend voor wetenschappelijk onderzoek verwerkt, in overeenstemming met de Algemene Verordening Gegevensbescherming (AVG).&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>Vragen over of feedback op dit onderzoek? Mail&nbsp;<a href=\"mailto:t.q.vanommeren@uva.nl\">t.q.vanommeren@uva.nl</a>.</p>\n\n<p><br />\n<br />\n&nbsp;</p>", "QuestionText_Unsafe": "<h3>Welkom &amp; informed consent</h3><p>Bedankt voor je deelname aan dit onderzoek van de Universiteit Utrecht. Deze vragenlijst gaat over hoe mensen in Nederland denken en voelen over drugs en drugsbeleid. Invullen duurt ongeveer <b>10&ndash;15 minuten</b>.</p><p><b>Vrijwillig &amp; anoniem.</b> Deelname is volledig vrijwillig. Je kunt op elk moment stoppen zonder opgaaf van reden door het venster te sluiten; je antwoorden worden dan niet gebruikt. De vragenlijst is anoniem: we vragen geen naam, adres of andere direct herleidbare gegevens. Antwoorden worden vertrouwelijk en uitsluitend voor wetenschappelijk onderzoek verwerkt, in overeenstemming met de AVG.</p><p><b>Gevoelige onderwerpen.</b> Sommige vragen gaan over eigen drugsgebruik. Je bent nooit verplicht een vraag te beantwoorden en er zijn geen goede of foute antwoorden.</p><p>Vragen over dit onderzoek? Mail <a href='mailto:timovanommeren@gmail.com'>timovanommeren@gmail.com</a>.</p>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Welkom & informed consent   Bedankt voor je deelname aan dit onderzoek van de Universiteit van Am...", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Willkommen &amp; informierte Einwilligung</h3><div><br></div><p>Vielen Dank für deine Teilnahme an dieser Studie der Universität von Amsterdam. Dieser Fragebogen handelt davon, wie Menschen in deinem Land zu Drogen und zur Drogenpolitik stehen, was sie darüber denken und wie sie sich entsprechend verhalten. Das Ausfüllen dauert etwa <b>10–15 Minuten</b>.</p><p><br></p><p><b>Freiwillig &amp; anonym.</b> Die Teilnahme ist völlig freiwillig. Du kannst jederzeit ohne Angabe von Gründen aufhören, indem du das Fenster schließt; deine Antworten werden dann nicht verwendet. Der Fragebogen ist anonym: Wir fragen nicht nach Namen, Adresse oder anderen direkt identifizierbaren Daten. Die Antworten werden vertraulich und ausschließlich für wissenschaftliche Forschung verarbeitet, im Einklang mit der Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Fragen oder Feedback zu dieser Studie? Schreib an <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "EN-GB": {"QuestionText": "<h3>Welcome &amp; informed consent</h3><div><br></div><p>Thank you for taking part in this study by the University of Amsterdam. This questionnaire is about how people in your country view drugs and drug policy, what they think of them, and how they behave in relation to them. Completing it takes about <b>10–15 minutes</b>.</p><p><br></p><p><b>Voluntary &amp; anonymous.</b> Participation is entirely voluntary. You can stop at any time without giving a reason by closing the window; your answers will then not be used. The questionnaire is anonymous: we do not ask for your name, address or other directly identifiable information. Answers are processed confidentially and exclusively for scientific research, in accordance with the Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Questions about or feedback on this study? Email <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "ES": {"QuestionText": "<h3>Bienvenida y consentimiento informado</h3><div><br></div><p>Gracias por participar en este estudio de la Universidad de Ámsterdam. Este cuestionario trata sobre cómo las personas en tu país ven las drogas y la política de drogas, qué opinan de ellas y cómo se comportan al respecto. Completarlo toma aproximadamente <b>10–15 minutos</b>.</p><p><br></p><p><b>Voluntario y anónimo.</b> La participación es completamente voluntaria. Puedes parar en cualquier momento, sin dar ninguna razón, cerrando la ventana; tus respuestas no serán utilizadas. El cuestionario es anónimo: no pedimos tu nombre, dirección ni otros datos que permitan identificarte directamente. Las respuestas se procesan de manera confidencial y exclusivamente para la investigación científica, de conformidad con el Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>¿Preguntas o comentarios sobre este estudio? Escribe a <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "ES-ES": {"QuestionText": "<h3>Bienvenida y consentimiento informado</h3><div><br></div><p>Gracias por participar en este estudio de la Universidad de Ámsterdam. Este cuestionario trata sobre cómo las personas en tu país ven las drogas y la política de drogas, qué opinan de ellas y cómo se comportan al respecto. Completarlo lleva aproximadamente <b>10–15 minutos</b>.</p><p><br></p><p><b>Voluntario y anónimo.</b> La participación es completamente voluntaria. Puedes parar en cualquier momento, sin dar ninguna razón, cerrando la ventana; tus respuestas no serán utilizadas. El cuestionario es anónimo: no pedimos tu nombre, dirección ni otros datos que permitan identificarte directamente. Las respuestas se procesan de manera confidencial y exclusivamente para la investigación científica, de conformidad con el Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>¿Preguntas o comentarios sobre este estudio? Escribe a <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "FR": {"QuestionText": "<h3>Bienvenue et consentement éclairé</h3><div><br></div><p>Merci de participer à cette étude de l’Université d’Amsterdam. Ce questionnaire porte sur la façon dont les habitants de votre pays perçoivent les drogues et la politique en matière de drogues, ce qu’ils en pensent et comment ils se comportent à cet égard. Le remplir prend environ <b>10–15 minutes</b>.</p><p><br></p><p><b>Volontaire et anonyme.</b> La participation est entièrement volontaire. Vous pouvez arrêter à tout moment, sans donner de raison, en fermant la fenêtre ; vos réponses ne seront alors pas utilisées. Le questionnaire est anonyme : nous ne demandons ni nom, ni adresse, ni aucune autre donnée directement identifiable. Les réponses sont traitées de manière confidentielle et exclusivement à des fins de recherche scientifique, conformément à l’Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Des questions ou des remarques sur cette étude ? Écrivez à <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "IT": {"QuestionText": "<h3>Benvenuto e consenso informato</h3><div><br></div><p>Grazie per la tua partecipazione a questo studio dell’Università di Amsterdam. Questo questionario riguarda il modo in cui le persone nel tuo paese vedono le droghe e la politica in materia di droghe, cosa ne pensano e come si comportano al riguardo. La compilazione richiede circa <b>10–15 minuti</b>.</p><p><br></p><p><b>Volontario e anonimo.</b> La partecipazione è del tutto volontaria. Puoi interrompere in qualsiasi momento, senza fornire alcuna motivazione, chiudendo la finestra; le tue risposte non verranno utilizzate. Il questionario è anonimo: non chiediamo nome, indirizzo o altri dati direttamente identificabili. Le risposte vengono trattate in modo riservato ed esclusivamente a fini di ricerca scientifica, in conformità con l’Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Domande o commenti su questo studio? Scrivi a <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "PT": {"QuestionText": "<h3>Boas-vindas e consentimento informado</h3><div><br></div><p>Obrigado por participar neste estudo da Universidade de Amsterdam. Este questionário é sobre como as pessoas no seu país veem as drogas e a política de drogas, o que pensam sobre elas e como se comportam em relação a elas. O preenchimento leva cerca de <b>10–15 minutos</b>.</p><p><br></p><p><b>Voluntário e anónimo.</b> A participação é totalmente voluntária. Pode parar a qualquer momento, sem dar qualquer razão, fechando a janela; as suas respostas não serão utilizadas. O questionário é anónimo: não pedimos nome, endereço nem outros dados que permitam uma identificação direta. As respostas são processadas de forma confidencial e exclusivamente para investigação científica, em conformidade com o Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Dúvidas ou comentários sobre este estudo? Envie um e-mail para <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}, "PT-BR": {"QuestionText": "<h3>Boas-vindas e consentimento informado</h3><div><br></div><p>Obrigado por participar deste estudo da Universidade de Amsterdam. Este questionário é sobre como as pessoas no seu país veem as drogas e a política de drogas, o que pensam sobre elas e como se comportam em relação a elas. O preenchimento leva cerca de <b>10–15 minutos</b>.</p><p><br></p><p><b>Voluntário e anônimo.</b> A participação é totalmente voluntária. Você pode parar a qualquer momento, sem dar qualquer justificativa, fechando a janela; suas respostas não serão utilizadas. O questionário é anônimo: não pedimos nome, endereço nem outros dados que permitam uma identificação direta. As respostas são processadas de forma confidencial e exclusivamente para pesquisa científica, em conformidade com o Algemene Verordening Gegevensbescherming (AVG).</p><p><br></p><p>Dúvidas ou comentários sobre este estudo? Envie um e-mail para <a href=\"mailto:timovanommeren@gmail.com\">t.q.vanommeren@uva.nl</a>.</p>"}}, "QuestionID": "QID1", "DataExportTag": "intro_consent", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID10", "SecondaryAttribute": "De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je...", "TertiaryAttribute": null, "Payload": {"QuestionText": "<p style=\"margin-bottom:6px;\">De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je mag een vraag ook overslaan.<br><br>Geef voor elk van de drugs hieronder aan hoe vaak je het hebt gebruikt.&nbsp;</p>", "QuestionText_Unsafe": "Heb je de volgende middelen <b>ooit in je leven</b> gebruikt?", "QuestionType": "Matrix", "Selector": "Likert", "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "MobileFirst": true, "WhiteSpace": "ON"}, "QuestionDescription": "De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je...", "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "<p style=\"margin-bottom:6px;\">Gib für jede der folgenden Substanzen an, wie oft du sie konsumiert hast.&nbsp;</p>", "Choices": {"1": {"Display": "Alkohol"}, "2": {"Display": "Nikotinprodukte"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychedelika"}}, "Answers": {"1": {"Display": "nie"}, "2": {"Display": "nicht (im letzten Jahr)"}, "3": {"Display": "gelegentlich (im letzten Jahr)"}, "4": {"Display": "oft (im letzten Jahr)"}}}, "EN-GB": {"QuestionText": "<p style=\"margin-bottom:6px;\">For each of the substances below, indicate how often you have used it.&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Nicotine products"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychedelics"}}, "Answers": {"1": {"Display": "never"}, "2": {"Display": "not (in the past year)"}, "3": {"Display": "occasionally (in the past year)"}, "4": {"Display": "often (in the past year)"}}}, "ES": {"QuestionText": "<p style=\"margin-bottom:6px;\">Indica para cada una de las siguientes sustancias con qué frecuencia la has consumido.&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Productos de nicotina"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}}, "Answers": {"1": {"Display": "nunca"}, "2": {"Display": "no (en el último año)"}, "3": {"Display": "alguna vez (en el último año)"}, "4": {"Display": "a menudo (en el último año)"}}}, "ES-ES": {"QuestionText": "<p style=\"margin-bottom:6px;\">Indica para cada una de las siguientes sustancias con qué frecuencia la has consumido.&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Productos de nicotina"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}}, "Answers": {"1": {"Display": "nunca"}, "2": {"Display": "no (en el último año)"}, "3": {"Display": "alguna vez (en el último año)"}, "4": {"Display": "a menudo (en el último año)"}}}, "FR": {"QuestionText": "<p style=\"margin-bottom:6px;\">Pour chacune des substances ci-dessous, indiquez à quelle fréquence vous l’avez consommée.&nbsp;</p>", "Choices": {"1": {"Display": "Alcool"}, "2": {"Display": "Produits nicotinés"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychédéliques"}}, "Answers": {"1": {"Display": "jamais"}, "2": {"Display": "pas (au cours de la dernière année)"}, "3": {"Display": "parfois (au cours de la dernière année)"}, "4": {"Display": "souvent (au cours de la dernière année)"}}}, "IT": {"QuestionText": "<p style=\"margin-bottom:6px;\">Indica per ciascuna delle sostanze qui sotto con quale frequenza l’hai usata.&nbsp;</p>", "Choices": {"1": {"Display": "Alcol"}, "2": {"Display": "Prodotti a base di nicotina"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psichedelici"}}, "Answers": {"1": {"Display": "mai"}, "2": {"Display": "no (nell’ultimo anno)"}, "3": {"Display": "qualche volta (nell’ultimo anno)"}, "4": {"Display": "spesso (nell’ultimo anno)"}}}, "PT": {"QuestionText": "<p style=\"margin-bottom:6px;\">Indique, para cada uma das substâncias abaixo, com que frequência a usou.&nbsp;</p>", "Choices": {"1": {"Display": "Álcool"}, "2": {"Display": "Produtos de nicotina"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}}, "Answers": {"1": {"Display": "nunca"}, "2": {"Display": "não (no último ano)"}, "3": {"Display": "às vezes (no último ano)"}, "4": {"Display": "frequentemente (no último ano)"}}}, "PT-BR": {"QuestionText": "<p style=\"margin-bottom:6px;\">Indique, para cada uma das substâncias abaixo, com que frequência você a usou.&nbsp;</p>", "Choices": {"1": {"Display": "Álcool"}, "2": {"Display": "Produtos de nicotina"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}}, "Answers": {"1": {"Display": "nunca"}, "2": {"Display": "não (no último ano)"}, "3": {"Display": "às vezes (no último ano)"}, "4": {"Display": "frequentemente (no último ano)"}}}}, "QuestionID": "QID10", "DataExportTag": "gebruik_ooit", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 10, "NextAnswerId": 5, "SubSelector": "SingleAnswer", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Tabak (en vapes)"}, "3": {"Display": "Softdrugs"}, "4": {"Display": "Harddrugs"}}, "ChoiceOrder": [1, 2, 3, 4], "Answers": {"1": {"Display": "nooit"}, "2": {"Display": "niet (in het laatste jaar)"}, "3": {"Display": "wel eens (in het laatste jaar)"}, "4": {"Display": "vaak (in het laatste jaar)"}}, "AnswerOrder": [1, 2, 3, 4], "ChoiceDataExportTags": false, "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n    // Language-aware version of the \"In het laatste jaar:\" bracket.\n    // Qualtrics runs ONE JS per question for ALL languages, so the bracket text\n    // is looked up from the respondent's current survey language, and the\n    // parenthetical part of the answer labels is stripped generically.\n\n    var q = jQuery(\"#\" + this.questionId);\n\n    var table = q.find(\"table.ChoiceStructure\").first();\n    if (table.length === 0) { return; }        // mobile accordion → keep full labels\n\n    var headerRow = table.find(\"tr\").first();\n    var numAnswerCols = 4;\n    var lead = headerRow.children().length - numAnswerCols;\n    if (lead < 0) { return; }                  // no real header → keep full labels\n\n    // Bracket label per language (Qualtrics language codes, uppercase)\n    var bracketText = {\n        \"NL\":    \"In het laatste jaar:\",\n        \"EN\":    \"In the past year:\",\n        \"EN-GB\": \"In the past year:\",\n        \"ES\":    \"En el último año:\",\n        \"ES-ES\": \"En el último año:\",\n        \"PT\":    \"No último ano:\",\n        \"PT-BR\": \"No último ano:\",\n        \"FR\":    \"Au cours de la dernière année :\",\n        \"IT\":    \"Nell’ultimo anno:\",\n        \"DE\":    \"Im letzten Jahr:\"\n    };\n\n    // Detect current survey language. Three sources, in order:\n    // 1. Q_Language embedded data (only resolves if declared in the survey flow)\n    // 2. the language dropdown Qualtrics puts on translated surveys\n    // 3. the page's html lang attribute\n    var lang = \"${e://Field/Q_Language}\";\n    if (!lang) {\n        var sel = jQuery(\"#Q_lang, select[name='Q_lang'], .LanguageSelectorContainer select\").first();\n        if (sel.length) { lang = sel.val(); }\n    }\n    if (!lang) { lang = document.documentElement.lang || \"\"; }\n    lang = String(lang).toUpperCase();\n\n    var label = bracketText[lang];\n    if (!label) { return; }                    // unknown language → keep full labels, no bracket\n\n    // Strip \"(...)\" from the answer-column headers, whatever the language\n    headerRow.children().slice(lead).each(function() {\n        var c = jQuery(this);\n        c.html(c.html().replace(/\\s*\\([^)]*\\)\\s*/, \"\"));\n    });\n\n    var bracket = \"<div style='height:8px;margin:4px 8px 0;\" +\n                  \"border-top:2px solid #666;border-left:2px solid #666;border-right:2px solid #666;'></div>\";\n\n    var html = \"<tr>\";\n    for (var i = 0; i < lead + 1; i++) { html += \"<td></td>\"; }\n    html += \"<td colspan='\" + (numAnswerCols - 1) + \"' \" +\n            \"style='text-align:center;font-weight:bold;padding:0 0 2px;vertical-align:bottom;'>\" +\n            label + bracket + \"</td></tr>\";\n    headerRow.before(html);\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t/*Place your JavaScript here to run when the page is fully displayed*/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t/*Place your JavaScript here to run when the page is unloaded*/\n\n});", "Randomization": {"Advanced": null, "ConsistentScaleReversal": false, "TotalRandSubset": "", "Type": "All"}}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID14", "SecondaryAttribute": "Deel 4 – Gevoelens", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 4 – Gevoelens</h3><p></p>", "QuestionText_Unsafe": "<h3>Deel 4 &ndash; Gevoelens</h3><p>Geef voor elk onderwerp hieronder aan hoe je je erover voelt. Gebruik de schuifbalk van <b>0 = heel negatief</b> (bijvoorbeeld angst, woede of afschuw) tot <b>100 = heel positief</b> (bijvoorbeeld blijdschap of opwinding). 50 is neutraal.</p>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Deel 4 – Gevoelens", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Teil 4 – Gefühle</h3><p></p>"}, "EN-GB": {"QuestionText": "<h3>Part 4 – Feelings</h3><p></p>"}, "ES": {"QuestionText": "<h3>Parte 4 – Sentimientos</h3><p></p>"}, "ES-ES": {"QuestionText": "<h3>Parte 4 – Sentimientos</h3><p></p>"}, "FR": {"QuestionText": "<h3>Partie 4 – Sentiments</h3><p></p>"}, "IT": {"QuestionText": "<h3>Parte 4 – Sentimenti</h3><p></p>"}, "PT": {"QuestionText": "<h3>Parte 4 – Sentimentos</h3><p></p>"}, "PT-BR": {"QuestionText": "<h3>Parte 4 – Sentimentos</h3><p></p>"}}, "QuestionID": "QID14", "DataExportTag": "gevoel_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID16", "SecondaryAttribute": "Deel 5 – Betrokkenheid De volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp...", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 5 – Betrokkenheid</h3><p>De volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp. Geef bij elke uitspraak aan of die bij jou past.</p>", "QuestionText_Unsafe": "<h3>Deel 5 &ndash; Betrokkenheid</h3><p>In hoeverre ben je het eens met de volgende uitspraken?</p>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Deel 5 – Betrokkenheid De volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp....", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Teil 5 &ndash; Engagement</h3><p>Inwieweit stimmst du den folgenden Aussagen zu?</p>"}, "EN-GB": {"QuestionText": "<h3>Part 5 &ndash; Involvement</h3><p>To what extent do you agree with the following statements?</p>"}, "ES": {"QuestionText": "<h3>Parte 5 &ndash; Implicación</h3><p>¿En qué medida estás de acuerdo con las siguientes afirmaciones?</p>"}, "ES-ES": {"QuestionText": "<h3>Parte 5 &ndash; Implicación</h3><p>¿En qué medida estás de acuerdo con las siguientes afirmaciones?</p>"}, "FR": {"QuestionText": "<h3>Partie 5 &ndash; Implication</h3><p>Dans quelle mesure êtes-vous d’accord avec les affirmations suivantes ?</p>"}, "IT": {"QuestionText": "<h3>Parte 5 &ndash; Coinvolgimento</h3><p>In che misura sei d’accordo con le seguenti affermazioni?</p>"}, "PT": {"QuestionText": "<h3>Parte 5 &ndash; Envolvimento</h3><p>Em que medida concorda com as seguintes afirmações?</p>"}, "PT-BR": {"QuestionText": "<h3>Parte 5 &ndash; Envolvimento</h3><p>Em que medida você concorda com as seguintes afirmações?</p>"}}, "QuestionID": "QID16", "DataExportTag": "betrok_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID17", "SecondaryAttribute": "Deel 5 – Betrokkenheid De volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Deel 5 &ndash; Betrokkenheid<br />\nDe volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp. Geef bij elke uitspraak aan of die bij jou past.", "DefaultChoices": false, "DataExportTag": "betrokkenheid", "QuestionID": "QID17", "QuestionType": "Slider", "Selector": "HSLIDER", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "above", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 0, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": false, "CustomStart": true, "NotApplicable": false, "MobileFirst": true, "SliderStartPositions": {"1": 0, "2": 0, "3": null}}, "QuestionDescription": "Deel 5 – Betrokkenheid De volgende uitspraken gaan over hoe betrokken je bent bij dit onderwerp....", "Choices": {"1": {"Display": "In mijn omgeving heb ik te maken met drugs of met criminaliteit door drugs."}, "2": {"Display": "Over drugs of over drugscriminaliteit weet ik meer dan de meeste mensen."}, "3": {"Display": "Hoe een partij omgaat met drugs en drugscriminaliteit, weegt mee bij mijn stemkeuze."}}, "ChoiceOrder": [1, 2, 3], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": {"DE": {"QuestionText": "Inwieweit stimmst du den folgenden Aussagen zu?", "Choices": {"1": {"Display": "In meinem Umfeld sehe ich Substanzkonsum oder die damit verbundene Kriminalität."}, "2": {"Display": "Ich weiß viel über Drogen und / oder Drogenpolitik."}, "3": {"Display": "Ich wäre bereit, Zeit oder Mühe zu investieren, um die Drogenpolitik zu beeinflussen (zum Beispiel wählen, eine Petition unterschreiben oder demonstrieren)."}}, "Labels": {"1": {"Display": "Stimme gar nicht zu"}, "2": {"Display": "Stimme nicht zu"}, "3": {"Display": "Stimme eher nicht zu"}, "4": {"Display": "Neutral"}, "5": {"Display": "Stimme eher zu"}, "6": {"Display": "Stimme zu"}, "7": {"Display": "Stimme voll zu"}}}, "EN-GB": {"QuestionText": "To what extent do you agree with the following statements?", "Choices": {"1": {"Display": "In my environment, I see substance use or the crime related to it."}, "2": {"Display": "I know a lot about drugs and / or drug policy."}, "3": {"Display": "I would be willing to put time or effort into influencing drug policy (for example voting, signing a petition or demonstrating)."}}, "Labels": {"1": {"Display": "Strongly disagree"}, "2": {"Display": "Disagree"}, "3": {"Display": "Somewhat disagree"}, "4": {"Display": "Neutral"}, "5": {"Display": "Somewhat agree"}, "6": {"Display": "Agree"}, "7": {"Display": "Strongly agree"}}}, "ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "En mi entorno veo consumo de sustancias o la criminalidad relacionada con él."}, "2": {"Display": "Sé mucho sobre drogas y / o política de drogas."}, "3": {"Display": "Estaría dispuesto/a a dedicar tiempo o esfuerzo a influir en la política de drogas (por ejemplo, votar, firmar una petición o manifestarme)."}}, "Labels": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "ES-ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "En mi entorno veo consumo de sustancias o la criminalidad relacionada con él."}, "2": {"Display": "Sé mucho sobre drogas y / o política de drogas."}, "3": {"Display": "Estaría dispuesto/a a dedicar tiempo o esfuerzo a influir en la política de drogas (por ejemplo, votar, firmar una petición o manifestarme)."}}, "Labels": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "FR": {"QuestionText": "Dans quelle mesure êtes-vous d’accord avec les affirmations suivantes ?", "Choices": {"1": {"Display": "Dans mon entourage, je vois de la consommation de substances ou la criminalité qui y est liée."}, "2": {"Display": "Je sais beaucoup de choses sur les drogues et / ou la politique des drogues."}, "3": {"Display": "Je serais prêt(e) à consacrer du temps ou des efforts pour influencer la politique des drogues (par exemple voter, signer une pétition ou manifester)."}}, "Labels": {"1": {"Display": "Pas du tout d’accord"}, "2": {"Display": "Pas d’accord"}, "3": {"Display": "Plutôt pas d’accord"}, "4": {"Display": "Neutre"}, "5": {"Display": "Plutôt d’accord"}, "6": {"Display": "D’accord"}, "7": {"Display": "Tout à fait d’accord"}}}, "IT": {"QuestionText": "In che misura sei d’accordo con le seguenti affermazioni?", "Choices": {"1": {"Display": "Nel mio ambiente vedo uso di sostanze o la criminalità ad esso collegata."}, "2": {"Display": "So molto su droghe e / o politica sulle droghe."}, "3": {"Display": "Sarei disposto/a a dedicare tempo o impegno per influenzare la politica sulle droghe (ad esempio votare, firmare una petizione o manifestare)."}}, "Labels": {"1": {"Display": "Molto in disaccordo"}, "2": {"Display": "In disaccordo"}, "3": {"Display": "Un po’ in disaccordo"}, "4": {"Display": "Neutrale"}, "5": {"Display": "Un po’ d’accordo"}, "6": {"Display": "D’accordo"}, "7": {"Display": "Molto d’accordo"}}}, "PT": {"QuestionText": "Em que medida concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "No meu meio, vejo uso de substâncias ou a criminalidade relacionada com ele."}, "2": {"Display": "Sei muito sobre drogas e / ou política de drogas."}, "3": {"Display": "Estaria disposto/a a dedicar tempo ou esforço para influenciar a política de drogas (por exemplo, votar, assinar uma petição ou manifestar-me)."}}, "Labels": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}, "PT-BR": {"QuestionText": "Em que medida você concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "No meu meio, vejo uso de substâncias ou a criminalidade relacionada a ele."}, "2": {"Display": "Sei muito sobre drogas e / ou política de drogas."}, "3": {"Display": "Estaria disposto/a a dedicar tempo ou esforço para influenciar a política de drogas (por exemplo, votar, assinar uma petição ou manifestar-me)."}}, "Labels": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}}, "NextChoiceId": 4, "NextAnswerId": 8, "Labels": {"1": {"Display": "Helemaal mee oneens"}, "2": {"Display": "Mee oneens"}, "3": {"Display": "Enigszins mee oneens"}, "4": {"Display": "Neutraal"}, "5": {"Display": "Enigszins mee eens"}, "6": {"Display": "Mee eens"}, "7": {"Display": "Helemaal mee eens"}}, "ChoiceDataExportTags": false, "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\t  var t = this.getQuestionContainer().querySelector('.QuestionText');\n  if (t) t.style.display = 'none';\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t/*Place your JavaScript here to run when the page is fully displayed*/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t/*Place your JavaScript here to run when the page is unloaded*/\n\n});"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID18", "SecondaryAttribute": "<h3>Tot slot &ndash; een paar achtergrondvragen</h3>", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Tot slot &ndash; een paar achtergrondvragen</h3>", "QuestionText_Unsafe": "<h3>Tot slot &ndash; een paar achtergrondvragen</h3>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "<h3>Tot slot &ndash; een paar achtergrondvragen</h3>", "Validation": {"Settings": {"Type": "None"}}, "Language": {"EN-GB": {"QuestionText": "<h3>Finally &ndash; a few background questions</h3>"}, "IT": {"QuestionText": "<h3>Per finire &ndash; alcune domande generali</h3>"}, "FR": {"QuestionText": "<h3>Pour finir &ndash; quelques questions générales</h3>"}, "PT-BR": {"QuestionText": "<h3>Para terminar &ndash; algumas perguntas gerais</h3>"}, "DE": {"QuestionText": "<h3>Zum Schluss &ndash; ein paar Hintergrundfragen</h3>"}, "PT": {"QuestionText": "<h3>Para terminar &ndash; algumas perguntas gerais</h3>"}, "ES-ES": {"QuestionText": "<h3>Para terminar &ndash; algunas preguntas generales</h3>"}, "ES": {"QuestionText": "<h3>Para terminar &ndash; algunas preguntas generales</h3>"}}, "QuestionID": "QID18", "DataExportTag": "demo_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID19", "SecondaryAttribute": "Wat is je leeftijd?", "TertiaryAttribute": null, "Payload": {"QuestionText": "Wat is je leeftijd?", "QuestionText_Unsafe": "Wat is je leeftijd?", "QuestionType": "MC", "Selector": "SAVR", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Wat is je leeftijd?", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"EN-GB": {"QuestionText": "What is your age?", "Choices": {"1": {"Display": "18–24 years"}, "2": {"Display": "25–34 years"}, "3": {"Display": "35–44 years"}, "4": {"Display": "45–54 years"}, "5": {"Display": "55–64 years"}, "6": {"Display": "65–74 years"}, "7": {"Display": "75 years or older"}}}, "IT": {"QuestionText": "Qual è la tua età?", "Choices": {"1": {"Display": "18–24 anni"}, "2": {"Display": "25–34 anni"}, "3": {"Display": "35–44 anni"}, "4": {"Display": "45–54 anni"}, "5": {"Display": "55–64 anni"}, "6": {"Display": "65–74 anni"}, "7": {"Display": "75 anni o più"}}}, "FR": {"QuestionText": "Quel est votre âge ?", "Choices": {"1": {"Display": "18–24 ans"}, "2": {"Display": "25–34 ans"}, "3": {"Display": "35–44 ans"}, "4": {"Display": "45–54 ans"}, "5": {"Display": "55–64 ans"}, "6": {"Display": "65–74 ans"}, "7": {"Display": "75 ans ou plus"}}}, "PT-BR": {"QuestionText": "Qual é a sua idade?", "Choices": {"1": {"Display": "18–24 anos"}, "2": {"Display": "25–34 anos"}, "3": {"Display": "35–44 anos"}, "4": {"Display": "45–54 anos"}, "5": {"Display": "55–64 anos"}, "6": {"Display": "65–74 anos"}, "7": {"Display": "75 anos ou mais"}}}, "DE": {"QuestionText": "Wie alt bist du?", "Choices": {"1": {"Display": "18–24 Jahre"}, "2": {"Display": "25–34 Jahre"}, "3": {"Display": "35–44 Jahre"}, "4": {"Display": "45–54 Jahre"}, "5": {"Display": "55–64 Jahre"}, "6": {"Display": "65–74 Jahre"}, "7": {"Display": "75 Jahre oder älter"}}}, "PT": {"QuestionText": "Qual é a sua idade?", "Choices": {"1": {"Display": "18–24 anos"}, "2": {"Display": "25–34 anos"}, "3": {"Display": "35–44 anos"}, "4": {"Display": "45–54 anos"}, "5": {"Display": "55–64 anos"}, "6": {"Display": "65–74 anos"}, "7": {"Display": "75 anos ou mais"}}}, "ES-ES": {"QuestionText": "¿Cuál es tu edad?", "Choices": {"1": {"Display": "18–24 años"}, "2": {"Display": "25–34 años"}, "3": {"Display": "35–44 años"}, "4": {"Display": "45–54 años"}, "5": {"Display": "55–64 años"}, "6": {"Display": "65–74 años"}, "7": {"Display": "75 años o más"}}}, "ES": {"QuestionText": "¿Cuál es tu edad?", "Choices": {"1": {"Display": "18–24 años"}, "2": {"Display": "25–34 años"}, "3": {"Display": "35–44 años"}, "4": {"Display": "45–54 años"}, "5": {"Display": "55–64 años"}, "6": {"Display": "65–74 años"}, "7": {"Display": "75 años o más"}}}}, "QuestionID": "QID19", "DataExportTag": "leeftijd", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 8, "NextAnswerId": 1, "SubSelector": "TX", "Choices": {"1": {"Display": "18–24 jaar"}, "2": {"Display": "25–34 jaar"}, "3": {"Display": "35–44 jaar"}, "4": {"Display": "45–54 jaar"}, "5": {"Display": "55–64 jaar"}, "6": {"Display": "65–74 jaar"}, "7": {"Display": "75 jaar of ouder"}}, "ChoiceOrder": ["1", "2", "3", "4", "5", "6", "7"]}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID2", "SecondaryAttribute": "Beste deelnemer, Welkom bij dit onderzoek van de Faculteit der Maatschappij- en Gedragswetenschap...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Beste deelnemer,<br>\n<br>\nWelkom bij dit onderzoek van de Faculteit der Maatschappij- en Gedragswetenschappen van de Universiteit van Amsterdam (UvA). Lees deze tekst goed door voordat je begint. Is er iets onduidelijk? Stuur dan een mail naar<a href=\"http://t.q.vanommeren@uva.nl\"> t.q.vanommeren@uva.nl</a>&nbsp;<br>\n<br>\n<strong>Waarom doen we dit onderzoek?</strong><br>\nEr wordt in Nederland veel gepraat over drugs en over de regels voor drugs. Wij willen weten hoe mensen daarover denken en voelen. Zo krijgen we een beter beeld van wat er in Nederland leeft.<br>\n<br>\n<strong>Wat gebeurt er als ik meedoe?</strong><br>\nJe vult een vragenlijst in op je computer of telefoon. <em>Dat duurt ongeveer 10 minuten.</em> Je krijgt vragen over drugs, over de regels voor drugs, en over wat je zelf doet en voelt. We vragen ook of je zelf weleens drugs gebruikt. Er zijn geen goede of foute antwoorden. Sommige vragen gaan over een gevoelig onderwerp. Vind je een vraag vervelend? Dan mag je stoppen.<br>\n<br>\n<strong>Moet ik meedoen?</strong><br>\nJe deelname is vrijwillig. Als je besluit te stoppen, heeft dat geen gevolgen voor je en je hoeft niet uit te leggen waarom je stopt. Je kunt op ieder moment tijdens het onderzoek besluiten te stoppen door je browser te sluiten.<br>\n<br>\n<strong>Wat gebeurt er met mijn gegevens?</strong><br>Je persoonsgegevens worden zorgvuldig behandeld, zoals bepaald door de wet (de Algemene Verordening Gegevensbescherming of AVG). Je persoonsgegevens worden verzameld door (een) derde partij/en. We hebben contracten met deze partij/en om je privacy te beschermen. Onderzoeksgegevens kunnen worden gepubliceerd en hergebruikt in ander onderzoek, maar alleen op een manier waarop jij niet herkend kunt worden.<br>\n<br>\n<strong>Hoe lang worden mijn gegevens bewaard?</strong><br>\nDe onderzoeksgegevens en andere materialen worden beveiligd gearchiveerd voor minstens tien jaar na afloop van het project. We verwijderen je persoonsgegevens, en de onderzoeksgegevens zijn vanaf dat moment anoniem.<br>\n<br>\n<strong>Meer informatie</strong><br>\nls je vragen hebt over het onderzoek [FMG-20487_2026], voor of na je deelname, neem dan contact op met de verantwoordelijke onderzoeker: Timo van Ommeren, <a href=\"http://t.q.vanommeren@uva.nl\">t.q.vanommeren@uva.nl</a>, of Han van der Maas, <a href=\"http://H.L.J.vanderMaas@uva.nl\">H.L.J.vanderMaas@uva.nl</a>.<br>\nAls je klachten hebt over het onderzoek, neem dan contact op met de Commissie Ethiek (CE) van Psychologie <a href=\"http://melding-ethiek-psy-fmg@uva.nl\">melding-ethiek-psy-fmg@uva.nl</a><br>\nAls je klachten hebt over de verwerking van je persoonsgegevens, neem dan contact op met de Functionaris Gegevensbescherming van de Universiteit van Amsterdam via <a href=\"http://fg@uva.nl\">fg@uva.nl</a>.<br>\n<br>\nMet vriendelijke groet,<br>\nTimo van Ommeren en Han van der Maas", "QuestionText_Unsafe": "Ik ben 18 jaar of ouder, heb bovenstaande informatie gelezen en geef vrijwillig toestemming om deel te nemen aan dit onderzoek.", "QuestionType": "MC", "Selector": "SAVR", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Beste deelnemer, Welkom bij dit onderzoek van de Faculteit der Maatschappij- en Gedragswetenschap...", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "Ich bin 16 Jahre oder älter, habe die obenstehenden Informationen gelesen und willige freiwillig ein, an dieser Studie teilzunehmen.", "Choices": {"1": {"Display": "Ja, ich willige ein"}, "2": {"Display": "Nein, ich möchte nicht teilnehmen"}}}, "EN-GB": {"QuestionText": "I am 16 years of age or older, have read the information above, and voluntarily consent to take part in this study.", "Choices": {"1": {"Display": "Yes, I consent"}, "2": {"Display": "No, I do not wish to take part"}}}, "ES": {"QuestionText": "Tengo 16 años o más, he leído la información anterior y doy mi consentimiento voluntario para participar en este estudio.", "Choices": {"1": {"Display": "Sí, doy mi consentimiento"}, "2": {"Display": "No, no quiero participar"}}}, "ES-ES": {"QuestionText": "Tengo 16 años o más, he leído la información anterior y doy mi consentimiento voluntario para participar en este estudio.", "Choices": {"1": {"Display": "Sí, doy mi consentimiento"}, "2": {"Display": "No, no quiero participar"}}}, "FR": {"QuestionText": "J’ai 16 ans ou plus, j’ai lu les informations ci-dessus et je consens volontairement à participer à cette étude.", "Choices": {"1": {"Display": "Oui, je donne mon consentement"}, "2": {"Display": "Non, je ne souhaite pas participer"}}}, "IT": {"QuestionText": "Ho 16 anni o più, ho letto le informazioni sopra riportate e acconsento volontariamente a partecipare a questo studio.", "Choices": {"1": {"Display": "Sì, acconsento"}, "2": {"Display": "No, non desidero partecipare"}}}, "PT": {"QuestionText": "Tenho 16 anos ou mais, li as informações acima e consinto voluntariamente em participar neste estudo.", "Choices": {"1": {"Display": "Sim, dou o meu consentimento"}, "2": {"Display": "Não, não quero participar"}}}, "PT-BR": {"QuestionText": "Tenho 16 anos ou mais, li as informações acima e consinto voluntariamente em participar deste estudo.", "Choices": {"1": {"Display": "Sim, dou o meu consentimento"}, "2": {"Display": "Não, não quero participar"}}}}, "QuestionID": "QID2", "DataExportTag": "consent", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 3, "NextAnswerId": 1, "SubSelector": "TX", "Choices": {"1": {"Display": "Ja, ik ben 18 jaar of ouder, heb de bovenstaande informatie gelezen en geef vrijwillig toestemming om deel te nemen aan dit onderzoek."}, "2": {"Display": "Nee, ik wil niet deelnemen"}}, "ChoiceOrder": ["1", "2"]}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID20", "SecondaryAttribute": "Woon je in een middelgrote tot grote stad?", "TertiaryAttribute": null, "Payload": {"QuestionText": "Woon je in een middelgrote tot grote stad?", "QuestionText_Unsafe": "Woon je in een middelgrote tot grote stad in Nederland?", "QuestionType": "MC", "Selector": "SAVR", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Woon je in een middelgrote tot grote stad?", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "Wohnst du in einer mittelgroßen bis großen Stadt?", "Choices": {"1": {"Display": "Ja"}, "2": {"Display": "Nein"}}}, "EN-GB": {"QuestionText": "Do you live in a medium-sized to large city?", "Choices": {"1": {"Display": "Yes"}, "2": {"Display": "No"}}}, "ES": {"QuestionText": "¿Vives en una ciudad mediana o grande?", "Choices": {"1": {"Display": "Sí"}, "2": {"Display": "No"}}}, "ES-ES": {"QuestionText": "¿Vives en una ciudad mediana o grande?", "Choices": {"1": {"Display": "Sí"}, "2": {"Display": "No"}}}, "FR": {"QuestionText": "Habitez-vous dans une ville moyenne ou grande ?", "Choices": {"1": {"Display": "Oui"}, "2": {"Display": "Non"}}}, "IT": {"QuestionText": "Vivi in una città di medie o grandi dimensioni?", "Choices": {"1": {"Display": "Sì"}, "2": {"Display": "No"}}}, "PT": {"QuestionText": "Vive numa cidade média ou grande?", "Choices": {"1": {"Display": "Sim"}, "2": {"Display": "Não"}}}, "PT-BR": {"QuestionText": "Você mora em uma cidade de médio ou grande porte?", "Choices": {"1": {"Display": "Sim"}, "2": {"Display": "Não"}}}}, "QuestionID": "QID20", "DataExportTag": "stad", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 3, "NextAnswerId": 1, "SubSelector": "TX", "Choices": {"1": {"Display": "Ja"}, "2": {"Display": "Nee"}}, "ChoiceOrder": ["1", "2"]}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID21", "SecondaryAttribute": "Als er nu verkiezingen zouden zijn, zou ik stemmen op:", "TertiaryAttribute": null, "Payload": {"QuestionText": "Als er nu verkiezingen zouden zijn, zou ik stemmen op:", "QuestionText_Unsafe": "Als er nu verkiezingen zouden zijn, zou ik stemmen op:", "QuestionType": "MC", "Selector": "SAVR", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Als er nu verkiezingen zouden zijn, zou ik stemmen op:", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"EN-GB": {"QuestionText": "If there were an election now, I would vote for:", "Choices": {"1": {"Display": "Socialists, greens or more left"}, "2": {"Display": "Center left / liberal left"}, "3": {"Display": "Christian democrats"}, "4": {"Display": "Center right / liberal right"}, "5": {"Display": "Conservatives, nationalists or more right"}, "6": {"Display": "I would not vote"}, "7": {"Display": "Other"}}}, "IT": {"QuestionText": "Se ci fossero elezioni adesso, voterei per:", "Choices": {"1": {"Display": "Socialisti, verdi o più a sinistra"}, "2": {"Display": "Centrosinistra / sinistra liberale"}, "3": {"Display": "Democratici cristiani"}, "4": {"Display": "Centrodestra / destra liberale"}, "5": {"Display": "Conservatori, nazionalisti o più a destra"}, "6": {"Display": "Non voterei"}, "7": {"Display": "Altro"}}}, "FR": {"QuestionText": "S’il y avait des élections maintenant, je voterais pour :", "Choices": {"1": {"Display": "Socialistes, écologistes ou plus à gauche"}, "2": {"Display": "Centre gauche / gauche libérale"}, "3": {"Display": "Démocrates-chrétiens"}, "4": {"Display": "Centre droit / droite libérale"}, "5": {"Display": "Conservateurs, nationalistes ou plus à droite"}, "6": {"Display": "Je ne voterais pas"}, "7": {"Display": "Autre"}}}, "PT-BR": {"QuestionText": "Se houvesse eleições agora, eu votaria em:", "Choices": {"1": {"Display": "Socialistas, verdes ou mais à esquerda"}, "2": {"Display": "Centro-esquerda / esquerda liberal"}, "3": {"Display": "Democratas-cristãos"}, "4": {"Display": "Centro-direita / direita liberal"}, "5": {"Display": "Conservadores, nacionalistas ou mais à direita"}, "6": {"Display": "Eu não votaria"}, "7": {"Display": "Outro"}}}, "DE": {"QuestionText": "Wenn jetzt Wahlen wären, würde ich wählen:", "Choices": {"1": {"Display": "Sozialisten, Grüne oder weiter links"}, "2": {"Display": "Mitte-links / linksliberal"}, "3": {"Display": "Christdemokraten"}, "4": {"Display": "Mitte-rechts / rechtsliberal"}, "5": {"Display": "Konservative, Nationalisten oder weiter rechts"}, "6": {"Display": "Ich würde nicht wählen"}, "7": {"Display": "Sonstiges"}}}, "PT": {"QuestionText": "Se houvesse eleições agora, eu votaria em:", "Choices": {"1": {"Display": "Socialistas, verdes ou mais à esquerda"}, "2": {"Display": "Centro-esquerda / esquerda liberal"}, "3": {"Display": "Democratas-cristãos"}, "4": {"Display": "Centro-direita / direita liberal"}, "5": {"Display": "Conservadores, nacionalistas ou mais à direita"}, "6": {"Display": "Eu não votaria"}, "7": {"Display": "Outro"}}}, "ES-ES": {"QuestionText": "Si hubiera elecciones ahora, votaría a:", "Choices": {"1": {"Display": "Socialistas, verdes o más a la izquierda"}, "2": {"Display": "Centroizquierda / izquierda liberal"}, "3": {"Display": "Demócratas cristianos"}, "4": {"Display": "Centroderecha / derecha liberal"}, "5": {"Display": "Conservadores, nacionalistas o más a la derecha"}, "6": {"Display": "No votaría"}, "7": {"Display": "Otro"}}}, "ES": {"QuestionText": "Si hubiera elecciones ahora, votaría por:", "Choices": {"1": {"Display": "Socialistas, verdes o más a la izquierda"}, "2": {"Display": "Centroizquierda / izquierda liberal"}, "3": {"Display": "Demócratas cristianos"}, "4": {"Display": "Centroderecha / derecha liberal"}, "5": {"Display": "Conservadores, nacionalistas o más a la derecha"}, "6": {"Display": "No votaría"}, "7": {"Display": "Otro"}}}}, "QuestionID": "QID21", "DataExportTag": "stemgedrag", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 8, "NextAnswerId": 1, "SubSelector": "TX", "Choices": {"1": {"Display": "PRO (GroenLinks-PvdA) of linkser"}, "2": {"Display": "D66"}, "3": {"Display": "CDA / CU / SGP"}, "4": {"Display": "VVD"}, "5": {"Display": "JA21 / PVV / FvD"}, "6": {"Display": "Ik zou niet stemmen"}, "7": {"Display": "Anders"}}, "ChoiceOrder": ["1", "2", "3", "4", "5", "6", "7"]}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID22", "SecondaryAttribute": "Wat is je geslacht?", "TertiaryAttribute": null, "Payload": {"QuestionText": "Wat is je geslacht?", "QuestionText_Unsafe": "Wat is je geslacht?", "QuestionType": "MC", "Selector": "SAVR", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Wat is je geslacht?", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"EN-GB": {"QuestionText": "What is your gender?", "Choices": {"1": {"Display": "Male"}, "2": {"Display": "Female"}, "3": {"Display": "Other"}}}, "IT": {"QuestionText": "Qual è il tuo sesso?", "Choices": {"1": {"Display": "Uomo"}, "2": {"Display": "Donna"}, "3": {"Display": "Altro"}}}, "FR": {"QuestionText": "Quel est votre sexe ?", "Choices": {"1": {"Display": "Homme"}, "2": {"Display": "Femme"}, "3": {"Display": "Autre"}}}, "PT-BR": {"QuestionText": "Qual é o seu sexo?", "Choices": {"1": {"Display": "Masculino"}, "2": {"Display": "Feminino"}, "3": {"Display": "Outro"}}}, "DE": {"QuestionText": "Was ist dein Geschlecht?", "Choices": {"1": {"Display": "Männlich"}, "2": {"Display": "Weiblich"}, "3": {"Display": "Anderes"}}}, "PT": {"QuestionText": "Qual é o seu sexo?", "Choices": {"1": {"Display": "Masculino"}, "2": {"Display": "Feminino"}, "3": {"Display": "Outro"}}}, "ES-ES": {"QuestionText": "¿Cuál es tu sexo?", "Choices": {"1": {"Display": "Hombre"}, "2": {"Display": "Mujer"}, "3": {"Display": "Otro"}}}, "ES": {"QuestionText": "¿Cuál es tu sexo?", "Choices": {"1": {"Display": "Hombre"}, "2": {"Display": "Mujer"}, "3": {"Display": "Otro"}}}}, "QuestionID": "QID22", "DataExportTag": "geslacht", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 4, "NextAnswerId": 1, "SubSelector": "TX", "Choices": {"1": {"Display": "Man"}, "2": {"Display": "Vrouw"}, "3": {"Display": "Anders"}}, "ChoiceOrder": ["1", "2", "3"]}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID28", "SecondaryAttribute": "Deel 4 – Gevoelens De volgende uitspraken gaan over jouw gevoelens. Kruis voor elk onderwerp aan..", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 4 – Gevoelens</h3>\n<br>De volgende uitspraken gaan over jouw gevoelens. Kruis voor elk onderwerp aan welk gevoel je erbij hebt. Het gaat om hoe je over het onderwerp voelt, niet om hoe je je voelt als je het gebruikt.<br>\n<br>\n<i>Let op</i>: meerdere antwoorden per onderwerp mogen. Kies 'geen van deze' als je niets voelt.", "QuestionJS": false, "DefaultChoices": false, "DataExportTag": "Q28", "QuestionID": "QID28", "QuestionType": "Matrix", "Selector": "Likert", "SubSelector": "MultipleAnswer", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "WhiteSpace": "OFF", "MobileFirst": true}, "QuestionDescription": "Deel 4 – Gevoelens De volgende uitspraken gaan over jouw gevoelens. Kruis voor elk onderwerp aan...", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabak"}, "3": {"Display": "softdrugs"}, "4": {"Display": "harddrugs"}, "5": {"Display": "war on drugs"}, "6": {"Display": "legalisering van drugs"}}, "ChoiceOrder": [1, 2, 3, 4, 5, "6"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": {"DE": {"QuestionText": "Kreuze für jedes Thema an, welche Emotionen es bei dir hervorruft. <b>Achtung</b>:<i> mehrere Antworten pro Thema sind erlaubt</i>. Wähle 'keine davon', wenn du nichts empfindest.", "Choices": {"1": {"Display": "Alkohol"}, "2": {"Display": "Tabak"}, "3": {"Display": "weiche Drogen"}, "4": {"Display": "harte Drogen"}, "5": {"Display": "Drogenpolitik"}}, "Answers": {"1": {"Display": "Wut"}, "2": {"Display": "Angst / Sorge"}, "4": {"Display": "Freude"}, "5": {"Display": "keine davon"}}}, "EN-GB": {"QuestionText": "For each topic, tick the emotions it evokes in you. <b>Note</b>:<i> multiple answers per topic are allowed</i>. Choose 'none of these' if you do not feel anything.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tobacco"}, "3": {"Display": "soft drugs"}, "4": {"Display": "hard drugs"}, "5": {"Display": "drug policy"}}, "Answers": {"1": {"Display": "angry"}, "2": {"Display": "afraid / worried"}, "4": {"Display": "happy"}, "5": {"Display": "none of these"}}}, "ES": {"QuestionText": "Marca para cada tema qué emociones te evoca. <b>Atención</b>:<i> se permiten varias respuestas por tema</i>. Elige 'ninguna de estas' si no sientes nada.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas blandas"}, "4": {"Display": "drogas duras"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "enojo"}, "2": {"Display": "miedo / preocupación"}, "4": {"Display": "alegría"}, "5": {"Display": "ninguna de estas"}}}, "ES-ES": {"QuestionText": "Marca para cada tema qué emociones te evoca. <b>Atención</b>:<i> se permiten varias respuestas por tema</i>. Elige 'ninguna de estas' si no sientes nada.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas blandas"}, "4": {"Display": "drogas duras"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "enfado"}, "2": {"Display": "miedo / preocupación"}, "4": {"Display": "alegría"}, "5": {"Display": "ninguna de estas"}}}, "FR": {"QuestionText": "Pour chaque sujet, cochez les émotions qu’il évoque en vous. <b>Attention</b>:<i> plusieurs réponses par sujet sont autorisées</i>. Choisissez 'aucune de celles-ci' si vous ne ressentez rien.", "Choices": {"1": {"Display": "alcool"}, "2": {"Display": "tabac"}, "3": {"Display": "drogues douces"}, "4": {"Display": "drogues dures"}, "5": {"Display": "politique des drogues"}}, "Answers": {"1": {"Display": "colère"}, "2": {"Display": "peur / inquiétude"}, "4": {"Display": "joie"}, "5": {"Display": "aucune de celles-ci"}}}, "IT": {"QuestionText": "Per ogni tema, segna le emozioni che suscita in te. <b>Attenzione</b>:<i> sono consentite più risposte per tema</i>. Scegli 'nessuna di queste' se non provi nulla.", "Choices": {"1": {"Display": "alcol"}, "2": {"Display": "tabacco"}, "3": {"Display": "droghe leggere"}, "4": {"Display": "droghe pesanti"}, "5": {"Display": "politica sulle droghe"}}, "Answers": {"1": {"Display": "rabbia"}, "2": {"Display": "paura / preoccupazione"}, "4": {"Display": "gioia"}, "5": {"Display": "nessuna di queste"}}}, "PT": {"QuestionText": "Assinale, para cada tema, as emoções que ele desperta. <b>Atenção</b>:<i> são permitidas várias respostas por tema</i>. Escolha 'nenhuma destas' se não sentir nada.", "Choices": {"1": {"Display": "álcool"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas leves"}, "4": {"Display": "drogas pesadas"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "raiva"}, "2": {"Display": "medo / preocupação"}, "4": {"Display": "alegria"}, "5": {"Display": "nenhuma destas"}}}, "PT-BR": {"QuestionText": "Marque, para cada tema, as emoções que ele desperta. <b>Atenção</b>:<i> são permitidas várias respostas por tema</i>. Escolha 'nenhuma destas' se você não sentir nada.", "Choices": {"1": {"Display": "álcool"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas leves"}, "4": {"Display": "drogas pesadas"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "raiva"}, "2": {"Display": "medo / preocupação"}, "4": {"Display": "alegria"}, "5": {"Display": "nenhuma destas"}}}}, "NextChoiceId": 7, "NextAnswerId": 6, "Answers": {"1": {"Display": "boos"}, "2": {"Display": "bang / bezorgd"}, "4": {"Display": "blij"}, "5": {"Display": "geen van deze", "ExclusiveAnswer": true}}, "AnswerOrder": [1, 2, 4, 5], "ChoiceDataExportTags": false}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID3", "SecondaryAttribute": "Deel 1 – Voorkeur voor drugsbeleid   Er zijn veel verschillende manieren om regels te maken voor.", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 1 – Voorkeur voor drugsbeleid</h3>\n\n<div>&nbsp;</div>\n\n<p>Er zijn veel verschillende manieren om regels te maken voor drugs.</p>\n\n<p><br>\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk beleid jij het beste vindt. Dat doe je op een schaal van 0 tot 100:<br>\n&nbsp;</p>\n\n<ul>\n\t<li><strong>0&nbsp;</strong>(helemaal links) = een streng verbod</li>\n\t<li><strong>100&nbsp;</strong>(helemaal rechts) = iedereen mag het vrij verkopen</li>\n</ul>\n\n<p>&nbsp;</p>\n\n<p>We beschrijven hieronder zeven soorten regels. Lees ze allemaal goed door.<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Verbod</b> (0) – Verkopen mag niet. Kopen en zelf gebruiken mag ook niet. Je kunt straf krijgen.</li>\n\t<li><b>Verbod op verkoop</b> (17) – Verkopen mag niet. Maar je mag wel&nbsp;kopen voor jezelf en gebruiken.</li>\n\t<li><strong>Verbod, behalve medicijnen&nbsp;</strong>(33) – Verkopen mag niet. Alleen een dokter mag het voorschrijven.</li>\n\t<li><b>Verkoop zonder winst</b> (50) – Verkopen mag, maar niemand mag er geld aan verdienen (bijvoorbeeld verkoop door de door de overheid, een stichting of een vereniging).</li>\n\t<li><b>Verkoop met winst, zonder reclame</b>&nbsp;(67) – Bedrijven mogen het verkopen en er geld aan verdienen. Maar er mag <em>geen </em>reclame gemaakt worden</li>\n\t<li><b>Verkoop met reclame&nbsp;</b>(83) – Bedrijven mogen het verkopen en er geld aan verdienen.&nbsp;Reclame maken mag <em>wel</em>.</li>\n\t<li><b>Vrije verkoop</b> (100) – Iedereen mag het verkopen. Er zijn geen speciale regels.</li>\n</ol>\n<br>\nVind je dat het antwoord tussen twee opties in ligt? Dan mag je ook een getal daartussen kiezen. Bijvoorbeeld 75, als je vindt dat reclame soms wel mag en soms niet.\n<ul style=\"line-height:1.5\">\n</ul>", "QuestionText_Unsafe": "<h3>Deel 1 &ndash; Voorkeur voor drugsbeleid</h3><p>Drugs kunnen op heel verschillende manieren worden gereguleerd, van een streng verbod tot volledig vrije verkoop. Hieronder staan zes vormen van beleid, oplopend van de meest strenge (links, 0) tot de meest vrije (rechts, 100):</p><ol style='line-height:1.5'><li><b>Verbod</b> (0) &ndash; zowel verkoop als koop/bezit zijn verboden en strafbaar.</li><li><b>Verbod op verkoop</b> (20) &ndash; verkoop is verboden, maar koop en bezit voor eigen gebruik zijn toegestaan.</li><li><b>Verkoop zonder winst</b> (40) &ndash; gereguleerde verkoop zonder winstoogmerk (door overheid, stichtingen of verenigingen).</li><li><b>Verkoop met winst, zonder marketing</b> (60) &ndash; gereguleerde commerci&euml;le verkoop, maar zonder reclame of marketing.</li><li><b>Verkoop met marketing</b> (80) &ndash; gereguleerde commerci&euml;le verkoop met reclame en marketing.</li><li><b>Vrije verkoop</b> (100) &ndash; ongereguleerde commerci&euml;le verkoop.</li></ol><p>We vragen je voorkeur voor drie categorie&euml;n middelen:</p><ul style='line-height:1.5'><li><b>Legale drugs</b> &ndash; middelen die nu legaal verkrijgbaar zijn, zoals alcohol, tabak en cafe&iuml;ne.</li><li><b>Lijst 1 (harddrugs)</b> &ndash; middelen met een &lsquo;onaanvaardbaar risico&rsquo; volgens de Opiumwet, zoals hero&iuml;ne, coca&iuml;ne, XTC/MDMA, amfetamine (speed), GHB en LSD.</li><li><b>Lijst 2 (softdrugs)</b> &ndash; middelen met een lager risico volgens de Opiumwet, zoals cannabis (wiet en hasj) en paddo&rsquo;s.</li></ul>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Deel 1 – Voorkeur voor drugsbeleid   Er zijn veel verschillende manieren om regels te maken voor...", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Teil 1 – Präferenzen für die Drogenpolitik</h3>\n\n<div>&nbsp;</div>\n\n<p>Drogen können auf sehr unterschiedliche Weise reguliert werden. Auf der nächsten Seite bitten wir dich, deine Präferenz für eine bestimmte Form der Regulierung für neun verschiedene Arten von Drogen anzugeben. Du kannst deine Präferenz auf einer Skala von<em> strengem Verbot</em> (links, 0) bis <em>völlig unreguliertem Verkauf</em> (rechts, 100) angeben. Insgesamt haben wir sieben Formen der Regulierung definiert. Lies dir alle sieben Formen sorgfältig durch:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Verbot</b> (0) – sowohl Verkauf als auch Kauf/Besitz sind verboten und strafbar.</li>\n\t<li><b>Verkaufsverbot</b> (17) – der Verkauf ist verboten, aber Kauf und Besitz für den Eigengebrauch sind erlaubt.</li>\n\t<li><strong>Verbot, nur medizinisch&nbsp;</strong>(33) – der Verkauf ist verboten; nur die medizinische Abgabe auf ärztliche Verschreibung ist erlaubt.&nbsp;</li>\n\t<li><b>Verkauf ohne Gewinn</b> (50) – regulierter Verkauf ohne Gewinn (durch Staat, Stiftungen oder Vereine).</li>\n\t<li><b>Verkauf mit Gewinn, ohne Marketing</b> (67) – regulierter kommerzieller Verkauf, aber ohne Werbung oder Marketing.</li>\n\t<li><b>Verkauf mit Marketing</b> (83) – regulierter kommerzieller Verkauf mit Werbung und Marketing.</li>\n\t<li><b>Unregulierter Verkauf</b> (100) – unregulierter kommerzieller Verkauf.</li>\n</ol>\n<br>\n<i><strong>Hinweis</strong>:&nbsp;</i>Es ist auch möglich, eine Position einzunehmen, die irgendwo zwischen den sieben oben genannten Optionen liegt. Zum Beispiel ein Wert von <em>70 </em>oder <em>80 </em>, wenn du der Meinung bist, dass Werbung und Marketing nur unter (strengen) Richtlinien erlaubt sein sollten. Oder zum Beispiel ein Wert von <em>20 </em>oder <em>30 </em>, wenn du der Meinung bist, dass die medizinische Abgabe nur unter (sehr) außergewöhnlichen Umständen erlaubt sein sollte. Viele weitere Zwischenformen sind denkbar.<div>&nbsp;</div>\n\n<p>Wir fragen nach deiner Präferenz für die folgenden Substanzen:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alkohol</b></li>\n\t<li><b>Nikotinprodukte (Tabak/Vapes)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psychedelika</b></li>\n\t<li><b>MDMA (Ecstasy)</b></li>\n\t<li><b>Kokain / Crack (Base)</b></li>\n\t<li><b>Speed ((Meth-)Amphetamin)</b></li>\n\t<li><b>Heroin</b></li>\n\t<li><b>Starke Schmerzmittel und Schlafmittel</b></li>\n</ul>"}, "EN-GB": {"QuestionText": "<h3>Part 1 – Drug policy preferences</h3>\n\n<div> </div>\n\n<p>Drugs can be regulated in very different ways. On the next page, you will be asked to give your preference for a particular form of regulation for nine different types of drugs. You can give your preference on a scale from<em> strict prohibition</em> (left, 0) to <em>completely unregulated sales</em> (right, 100). In total, we have defined seven forms of regulation. Read all seven forms carefully:<br />\n </p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Prohibition</b> (0) – both selling and buying/possession are prohibited and punishable.</li>\n\t<li><b>Ban on sales</b> (17) – selling is prohibited, but buying and possession for personal use are permitted.</li>\n\t<li><strong>Prohibition, medical only </strong>(33) – selling is prohibited; only medical provision on a doctor’s prescription is allowed. </li>\n\t<li><b>Non-profit sales</b> (50) – regulated sales without profit (by government, foundations or associations).</li>\n\t<li><b>For-profit sales, without marketing</b> (67) – regulated commercial sales, but without advertising or marketing.</li>\n\t<li><b>Sales with marketing</b> (83) – regulated commercial sales with advertising and marketing.</li>\n\t<li><b>Unregulated sales</b> (100) – unregulated commercial sales.</li>\n</ol>\n<br />\n<i><strong>Note</strong>: </i>It is also possible to take a position that lies somewhere in between the seven options listed above. For example, a score of <em>70 </em>or <em>80 </em>if you believe that advertising and marketing should only be allowed under (strict) guidelines. Or, for example, a score of <em>20 </em>or <em>30 </em>if you believe that medical provision should only be allowed under (very) exceptional circumstances. Many other intermediate positions are conceivable.\n\n<div> </div>\n\n<p>We ask for your preference for the following substances:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alcohol</b></li>\n\t<li><b>Nicotine products (tobacco/vapes)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psychedelics</b></li>\n\t<li><b>MDMA (ecstasy)</b></li>\n\t<li><b>Cocaine / crack (base coke)</b></li>\n\t<li><b>Speed ((meth)amphetamine)</b></li>\n\t<li><b>Heroin</b></li>\n\t<li><b>Heavy painkillers and sleeping medication</b></li>\n</ul>\n"}, "ES": {"QuestionText": "<h3>Parte 1 – Preferencias de política de drogas</h3>\n\n<div>&nbsp;</div>\n\n<p>Las drogas pueden regularse de maneras muy distintas. En la página siguiente te pediremos que indiques tu preferencia por una determinada forma de regulación para nueve tipos diferentes de drogas. Puedes indicar tu preferencia en una escala que va de<em> prohibición estricta</em> (izquierda, 0) a <em>venta totalmente no regulada</em> (derecha, 100). En total hemos definido siete formas de regulación. Lee con atención las siete formas:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Prohibición</b> (0) – tanto la venta como la compra/posesión están prohibidas y son punibles.</li>\n\t<li><b>Prohibición de la venta</b> (17) – la venta está prohibida, pero la compra y la posesión para uso personal están permitidas.</li>\n\t<li><strong>Prohibición, solo uso médico&nbsp;</strong>(33) – la venta está prohibida; solo se permite la dispensación médica con receta de un médico.&nbsp;</li>\n\t<li><b>Venta sin fines de lucro</b> (50) – venta regulada sin fines de lucro (por el gobierno, fundaciones o asociaciones).</li>\n\t<li><b>Venta con fines de lucro, sin marketing</b> (67) – venta comercial regulada, pero sin publicidad ni marketing.</li>\n\t<li><b>Venta con marketing</b> (83) – venta comercial regulada con publicidad y marketing.</li>\n\t<li><b>Venta no regulada</b> (100) – venta comercial no regulada.</li>\n</ol>\n<br>\n<i><strong>Atención</strong>:&nbsp;</i>También es posible adoptar una posición que se sitúe en algún punto entre las siete opciones mencionadas arriba. Por ejemplo, una puntuación de <em>70 </em>u <em>80 </em>si consideras que la publicidad y el marketing solo deberían permitirse bajo directrices (estrictas). O, por ejemplo, una puntuación de <em>20 </em>o <em>30 </em>si consideras que la dispensación médica solo debería permitirse en circunstancias (muy) excepcionales. Son concebibles muchas otras posiciones intermedias.<div>&nbsp;</div>\n\n<p>Te pedimos tu preferencia para las siguientes sustancias:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alcohol</b></li>\n\t<li><b>Productos de nicotina (tabaco/vapeadores)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psicodélicos</b></li>\n\t<li><b>MDMA (éxtasis)</b></li>\n\t<li><b>Cocaína / crack (cocaína base)</b></li>\n\t<li><b>Speed ((met)anfetamina)</b></li>\n\t<li><b>Heroína</b></li>\n\t<li><b>Analgésicos y somníferos fuertes</b></li>\n</ul>"}, "ES-ES": {"QuestionText": "<h3>Parte 1 – Preferencias de política de drogas</h3>\n\n<div>&nbsp;</div>\n\n<p>Las drogas pueden regularse de maneras muy distintas. En la página siguiente te pediremos que indiques tu preferencia por una determinada forma de regulación para nueve tipos diferentes de drogas. Puedes indicar tu preferencia en una escala que va de<em> prohibición estricta</em> (izquierda, 0) a <em>venta totalmente no regulada</em> (derecha, 100). En total hemos definido siete formas de regulación. Lee con atención las siete formas:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Prohibición</b> (0) – tanto la venta como la compra/posesión están prohibidas y son punibles.</li>\n\t<li><b>Prohibición de la venta</b> (17) – la venta está prohibida, pero la compra y la posesión para uso personal están permitidas.</li>\n\t<li><strong>Prohibición, solo uso médico&nbsp;</strong>(33) – la venta está prohibida; solo se permite la dispensación médica con receta de un médico.&nbsp;</li>\n\t<li><b>Venta sin ánimo de lucro</b> (50) – venta regulada sin ánimo de lucro (por el gobierno, fundaciones o asociaciones).</li>\n\t<li><b>Venta con ánimo de lucro, sin marketing</b> (67) – venta comercial regulada, pero sin publicidad ni marketing.</li>\n\t<li><b>Venta con marketing</b> (83) – venta comercial regulada con publicidad y marketing.</li>\n\t<li><b>Venta no regulada</b> (100) – venta comercial no regulada.</li>\n</ol>\n<br>\n<i><strong>Atención</strong>:&nbsp;</i>También es posible adoptar una posición que se sitúe en algún punto entre las siete opciones mencionadas arriba. Por ejemplo, una puntuación de <em>70 </em>u <em>80 </em>si consideras que la publicidad y el marketing solo deberían permitirse bajo directrices (estrictas). O, por ejemplo, una puntuación de <em>20 </em>o <em>30 </em>si consideras que la dispensación médica solo debería permitirse en circunstancias (muy) excepcionales. Son concebibles muchas otras posiciones intermedias.<div>&nbsp;</div>\n\n<p>Te pedimos tu preferencia para las siguientes sustancias:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alcohol</b></li>\n\t<li><b>Productos de nicotina (tabaco/vapeadores)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psicodélicos</b></li>\n\t<li><b>MDMA (éxtasis)</b></li>\n\t<li><b>Cocaína / crack (cocaína base)</b></li>\n\t<li><b>Speed ((met)anfetamina)</b></li>\n\t<li><b>Heroína</b></li>\n\t<li><b>Analgésicos y somníferos fuertes</b></li>\n</ul>"}, "FR": {"QuestionText": "<h3>Partie 1 – Préférences en matière de politique des drogues</h3>\n\n<div>&nbsp;</div>\n\n<p>Les drogues peuvent être réglementées de manières très différentes. Sur la page suivante, il vous sera demandé d’indiquer votre préférence pour une certaine forme de réglementation pour neuf types de drogues différents. Vous pouvez indiquer votre préférence sur une échelle allant de<em> l’interdiction stricte</em> (à gauche, 0) à <em>la vente totalement non réglementée</em> (à droite, 100). Au total, nous avons défini sept formes de réglementation. Lisez attentivement les sept formes :<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Interdiction</b> (0) – la vente comme l’achat/la possession sont interdits et punissables.</li>\n\t<li><b>Interdiction de la vente</b> (17) – la vente est interdite, mais l’achat et la possession pour usage personnel sont autorisés.</li>\n\t<li><strong>Interdiction, usage médical uniquement&nbsp;</strong>(33) – la vente est interdite ; seule la délivrance médicale sur ordonnance d’un médecin est autorisée.&nbsp;</li>\n\t<li><b>Vente sans but lucratif</b> (50) – vente réglementée sans but lucratif (par l’État, des fondations ou des associations).</li>\n\t<li><b>Vente à but lucratif, sans marketing</b> (67) – vente commerciale réglementée, mais sans publicité ni marketing.</li>\n\t<li><b>Vente avec marketing</b> (83) – vente commerciale réglementée avec publicité et marketing.</li>\n\t<li><b>Vente non réglementée</b> (100) – vente commerciale non réglementée.</li>\n</ol>\n<br>\n<i><strong>Attention</strong>:&nbsp;</i>Il est également possible d’adopter une position qui se situe quelque part entre les sept options mentionnées ci-dessus. Par exemple, un score de <em>70 </em>ou <em>80 </em>si vous estimez que la publicité et le marketing ne devraient être autorisés que selon des lignes directrices (strictes). Ou, par exemple, un score de <em>20 </em>ou <em>30 </em>si vous estimez que la délivrance médicale ne devrait être autorisée que dans des circonstances (très) exceptionnelles. De nombreuses autres positions intermédiaires sont envisageables.<div>&nbsp;</div>\n\n<p>Nous vous demandons votre préférence pour les substances suivantes :</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alcool</b></li>\n\t<li><b>Produits nicotinés (tabac/vapoteuses)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psychédéliques</b></li>\n\t<li><b>MDMA (ecstasy)</b></li>\n\t<li><b>Cocaïne / crack (cocaïne base)</b></li>\n\t<li><b>Speed ((méth)amphétamine)</b></li>\n\t<li><b>Héroïne</b></li>\n\t<li><b>Analgésiques et somnifères puissants</b></li>\n</ul>"}, "IT": {"QuestionText": "<h3>Parte 1 – Preferenze di politica sulle droghe</h3>\n\n<div>&nbsp;</div>\n\n<p>Le droghe possono essere regolamentate in modi molto diversi. Nella pagina successiva ti verrà chiesto di indicare la tua preferenza per una determinata forma di regolamentazione per nove diversi tipi di droghe. Puoi indicare la tua preferenza su una scala che va da<em> proibizione severa</em> (sinistra, 0) a <em>vendita completamente non regolamentata</em> (destra, 100). In totale abbiamo definito sette forme di regolamentazione. Leggi attentamente tutte e sette le forme:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Proibizione</b> (0) – sia la vendita sia l’acquisto/il possesso sono vietati e punibili.</li>\n\t<li><b>Divieto di vendita</b> (17) – la vendita è vietata, ma l’acquisto e il possesso per uso personale sono consentiti.</li>\n\t<li><strong>Proibizione, solo uso medico&nbsp;</strong>(33) – la vendita è vietata; è consentita solo la fornitura medica su prescrizione di un medico.&nbsp;</li>\n\t<li><b>Vendita senza scopo di lucro</b> (50) – vendita regolamentata senza scopo di lucro (da parte dello Stato, di fondazioni o associazioni).</li>\n\t<li><b>Vendita a scopo di lucro, senza marketing</b> (67) – vendita commerciale regolamentata, ma senza pubblicità né marketing.</li>\n\t<li><b>Vendita con marketing</b> (83) – vendita commerciale regolamentata con pubblicità e marketing.</li>\n\t<li><b>Vendita non regolamentata</b> (100) – vendita commerciale non regolamentata.</li>\n</ol>\n<br>\n<i><strong>Attenzione</strong>:&nbsp;</i>È anche possibile assumere una posizione che si collochi da qualche parte tra le sette opzioni sopra elencate. Ad esempio, un punteggio di <em>70 </em>o <em>80 </em>se ritieni che la pubblicità e il marketing debbano essere consentiti solo secondo linee guida (rigorose). Oppure, ad esempio, un punteggio di <em>20 </em>o <em>30 </em>se ritieni che la fornitura medica debba essere consentita solo in circostanze (molto) eccezionali. Sono concepibili molte altre posizioni intermedie.<div>&nbsp;</div>\n\n<p>Ti chiediamo la tua preferenza per le seguenti sostanze:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Alcol</b></li>\n\t<li><b>Prodotti a base di nicotina (tabacco/sigarette elettroniche)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psichedelici</b></li>\n\t<li><b>MDMA (ecstasy)</b></li>\n\t<li><b>Cocaina / crack (cocaina base)</b></li>\n\t<li><b>Speed ((met)anfetamina)</b></li>\n\t<li><b>Eroina</b></li>\n\t<li><b>Antidolorifici e sonniferi forti</b></li>\n</ul>"}, "PT": {"QuestionText": "<h3>Parte 1 – Preferências de política de drogas</h3>\n\n<div>&nbsp;</div>\n\n<p>As drogas podem ser reguladas de maneiras muito diferentes. Na próxima página, pedimos que indique a sua preferência por uma determinada forma de regulação para nove tipos diferentes de drogas. Pode indicar a sua preferência numa escala que vai de<em> proibição rigorosa</em> (esquerda, 0) a <em>venda totalmente não regulamentada</em> (direita, 100). No total, definimos sete formas de regulação. Leia atentamente as sete formas:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Proibição</b> (0) – tanto a venda como a compra/posse são proibidas e puníveis.</li>\n\t<li><b>Proibição da venda</b> (17) – a venda é proibida, mas a compra e a posse para uso pessoal são permitidas.</li>\n\t<li><strong>Proibição, apenas uso médico&nbsp;</strong>(33) – a venda é proibida; apenas é permitido o fornecimento médico com receita de um médico.&nbsp;</li>\n\t<li><b>Venda sem fins lucrativos</b> (50) – venda regulamentada sem fins lucrativos (pelo governo, fundações ou associações).</li>\n\t<li><b>Venda com fins lucrativos, sem marketing</b> (67) – venda comercial regulamentada, mas sem publicidade nem marketing.</li>\n\t<li><b>Venda com marketing</b> (83) – venda comercial regulamentada com publicidade e marketing.</li>\n\t<li><b>Venda não regulamentada</b> (100) – venda comercial não regulamentada.</li>\n</ol>\n<br>\n<i><strong>Atenção</strong>:&nbsp;</i>Também é possível assumir uma posição que fique em algum ponto entre as sete opções mencionadas acima. Por exemplo, uma pontuação de <em>70 </em>ou <em>80 </em>se considerar que a publicidade e o marketing só deveriam ser permitidos sob diretrizes (rigorosas). Ou, por exemplo, uma pontuação de <em>20 </em>ou <em>30 </em>se considerar que o fornecimento médico só deveria ser permitido em circunstâncias (muito) excecionais. Muitas outras posições intermédias são concebíveis.<div>&nbsp;</div>\n\n<p>Pedimos a sua preferência para as seguintes substâncias:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Álcool</b></li>\n\t<li><b>Produtos de nicotina (tabaco/vapes)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psicodélicos</b></li>\n\t<li><b>MDMA (ecstasy)</b></li>\n\t<li><b>Cocaína / crack (cocaína base)</b></li>\n\t<li><b>Speed ((met)anfetamina)</b></li>\n\t<li><b>Heroína</b></li>\n\t<li><b>Analgésicos e soníferos fortes</b></li>\n</ul>"}, "PT-BR": {"QuestionText": "<h3>Parte 1 – Preferências de política de drogas</h3>\n\n<div>&nbsp;</div>\n\n<p>As drogas podem ser reguladas de maneiras muito diferentes. Na próxima página, pediremos que você indique a sua preferência por uma determinada forma de regulação para nove tipos diferentes de drogas. Você pode indicar a sua preferência em uma escala que vai de<em> proibição rigorosa</em> (esquerda, 0) a <em>venda totalmente não regulamentada</em> (direita, 100). No total, definimos sete formas de regulação. Leia atentamente as sete formas:<br>\n&nbsp;</p>\n\n<ol style=\"line-height:1.5\">\n\t<li><b>Proibição</b> (0) – tanto a venda como a compra/posse são proibidas e puníveis.</li>\n\t<li><b>Proibição da venda</b> (17) – a venda é proibida, mas a compra e a posse para uso pessoal são permitidas.</li>\n\t<li><strong>Proibição, apenas uso médico&nbsp;</strong>(33) – a venda é proibida; apenas é permitido o fornecimento médico com receita de um médico.&nbsp;</li>\n\t<li><b>Venda sem fins lucrativos</b> (50) – venda regulamentada sem fins lucrativos (pelo governo, fundações ou associações).</li>\n\t<li><b>Venda com fins lucrativos, sem marketing</b> (67) – venda comercial regulamentada, mas sem publicidade nem marketing.</li>\n\t<li><b>Venda com marketing</b> (83) – venda comercial regulamentada com publicidade e marketing.</li>\n\t<li><b>Venda não regulamentada</b> (100) – venda comercial não regulamentada.</li>\n</ol>\n<br>\n<i><strong>Atenção</strong>:&nbsp;</i>Também é possível assumir uma posição que fique em algum ponto entre as sete opções mencionadas acima. Por exemplo, uma pontuação de <em>70 </em>ou <em>80 </em>se você considerar que a publicidade e o marketing só deveriam ser permitidos sob diretrizes (rigorosas). Ou, por exemplo, uma pontuação de <em>20 </em>ou <em>30 </em>se você considerar que o fornecimento médico só deveria ser permitido em circunstâncias (muito) excepcionais. Muitas outras posições intermediárias são concebíveis.<div>&nbsp;</div>\n\n<p>Pedimos a sua preferência para as seguintes substâncias:</p>\n\n<ul style=\"line-height:1.5\">\n\t<li><b>Álcool</b></li>\n\t<li><b>Produtos de nicotina (tabaco/vapes)</b></li>\n\t<li><b>Cannabis</b></li>\n\t<li><b>Psicodélicos</b></li>\n\t<li><b>MDMA (ecstasy)</b></li>\n\t<li><b>Cocaína / crack (cocaína base)</b></li>\n\t<li><b>Speed ((met)anfetamina)</b></li>\n\t<li><b>Heroína</b></li>\n\t<li><b>Analgésicos e soníferos fortes</b></li>\n</ul>"}}, "QuestionID": "QID3", "DataExportTag": "beleid_uitleg", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID31", "SecondaryAttribute": "Hoe heb je deze survey gevonden? ", "TertiaryAttribute": null, "Payload": {"QuestionText": "Hoe heb je deze survey gevonden?&nbsp;", "DefaultChoices": false, "DataExportTag": "Q22", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Hoe heb je deze survey gevonden? ", "Choices": {"1": {"Display": "Met mij gedeeld door de onderzoekers"}, "2": {"Display": "Met mij gedeeld door iemand anders"}, "3": {"Display": "Via social media"}, "5": {"Display": "Anders"}}, "ChoiceOrder": [1, 2, 3, 5], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": {"DE": {"QuestionText": "Wie hast du von dieser Umfrage erfahren?", "Choices": {"1": {"Display": "Direkt von dem/den Forschenden mit mir geteilt"}, "2": {"Display": "Von jemand anderem mit mir geteilt"}, "3": {"Display": "Über soziale Medien"}, "5": {"Display": "Sonstiges"}}}, "EN-GB": {"QuestionText": "How did you find out about this survey?", "Choices": {"1": {"Display": "Shared with me by the researcher(s) directly"}, "2": {"Display": "Shared with me by someone else"}, "3": {"Display": "Via social media"}, "5": {"Display": "Other"}}}, "ES": {"QuestionText": "¿Cómo te enteraste de esta encuesta?", "Choices": {"1": {"Display": "Me la compartió directamente el equipo de investigación"}, "2": {"Display": "Me la compartió otra persona"}, "3": {"Display": "A través de redes sociales"}, "5": {"Display": "Otro"}}}, "ES-ES": {"QuestionText": "¿Cómo te enteraste de esta encuesta?", "Choices": {"1": {"Display": "Me la envió directamente el equipo de investigación"}, "2": {"Display": "Me la envió otra persona"}, "3": {"Display": "A través de redes sociales"}, "5": {"Display": "Otro"}}}, "FR": {"QuestionText": "Comment avez-vous entendu parler de cette enquête ?", "Choices": {"1": {"Display": "Partagée avec moi directement par le(s) chercheur(s)"}, "2": {"Display": "Partagée avec moi par quelqu’un d’autre"}, "3": {"Display": "Via les réseaux sociaux"}, "5": {"Display": "Autre"}}}, "IT": {"QuestionText": "Come sei venuto/a a conoscenza di questo questionario?", "Choices": {"1": {"Display": "Condiviso con me direttamente dal ricercatore / dai ricercatori"}, "2": {"Display": "Condiviso con me da qualcun altro"}, "3": {"Display": "Tramite i social media"}, "5": {"Display": "Altro"}}}, "PT": {"QuestionText": "Como soube deste questionário?", "Choices": {"1": {"Display": "Partilhado comigo diretamente pela equipa de investigação"}, "2": {"Display": "Partilhado comigo por outra pessoa"}, "3": {"Display": "Através das redes sociais"}, "5": {"Display": "Outro"}}}, "PT-BR": {"QuestionText": "Como você ficou sabendo desta pesquisa?", "Choices": {"1": {"Display": "Compartilhado comigo diretamente pela equipe de pesquisa"}, "2": {"Display": "Compartilhado comigo por outra pessoa"}, "3": {"Display": "Pelas redes sociais"}, "5": {"Display": "Outro"}}}}, "NextChoiceId": 6, "NextAnswerId": 1, "QuestionID": "QID31"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID34", "SecondaryAttribute": "Deel 1 – Wat vind jij van drugsbeleid?   Er zijn veel verschillende manieren om regels te maken v", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 1 &ndash; Wat vind jij van drugsbeleid?</h3>\n&nbsp;\n\n<p>Er zijn veel verschillende manieren om regels te maken voor drugs.</p>\n\n<p><br />\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk beleid jij het beste vindt. Dat doe je door je voorkeur aan te geven op een schaal:</p>\n\n<p>&nbsp;</p>\n\n<ul>\n\t<li>Helemaal links&nbsp;= een streng verbod</li>\n\t<li>Helemaal rechts =&nbsp;iedereen mag het vrij verkopen</li>\n</ul>\n\n<p>&nbsp;</p>\n\n<p>We beschrijven hieronder negen soorten regels op deze schaal. Lees ze allemaal goed door. Probeer de plaatjes bij elke regel te onthouden.&nbsp;<br />\n&nbsp;</p>\n\n<ol>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"verbod\">​</span><b>Verbod &ndash; </b>Verkopen of verkrijgen is nooit toegestaan. Niemand mag het krijgen.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"onderzoek\">​</span><b>Alleen voor onderzoek &ndash; </b>Alleen onderzoekers mogen het gebruiken voor wetenschappelijk onderzoek. Verder blijft het verboden.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"behandeling\">​</span><b>Alleen als behandeling &ndash; </b>Alleen mensen die ernstig ziek of verslaafd zijn, kunnen het van een arts krijgen.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"recept\">​</span><b>Alleen op recept &ndash; </b>Een arts mag het voorschrijven aan iedereen die er baat bij heeft.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"speciaalzaak\">​</span><b>Alleen in speciaalzaak, zonder winst &ndash; </b>Alleen speciale winkels voor dit middel mogen het verkopen. Deze winkels mogen er geen winst op maken.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"winst\">​</span><b>Alleen in speciaalzaak, met winst &ndash; </b>Alleen speciale winkels voor dit middel mogen het verkopen. Deze winkels mogen er wel winst op maken.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"overal_te_koop\">​</span><b>Overal te koop, zonder reclame &ndash; </b>Ook gewone winkels en horeca mogen het verkopen en er winst op maken. Reclame maken mag niet.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"reclame\">​</span><b>Overal te koop, met reclame &ndash; </b>Ook gewone winkels en horeca mogen het verkopen en er winst op maken. Reclame maken mag wel.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"vrije_verkoop\">​</span><b>Vrije verkoop &ndash; </b>Iedereen mag het verkopen. Er zijn geen speciale regels.</p>\n\t</li>\n</ol>\n<br />\nJe mag ook een waarde tussen twee regels kiezen. Bijvoorbeeld tussen <i>Overal te koop, zonder reclame</i>&nbsp;en <i>Overal te koop, met reclame</i>, als je vindt dat reclame soms wel mag en soms niet.<br />\n<br />\n<br />\n<strong>Eerst twee oefenvragen.</strong><br />\n<br />\nStel dat je het met de volgende regels eens bent. Welke regel kies je dan?\n<ol>\n\t<li>In Nederland mag je ADHD-pillen alleen kopen op recept van je dokter.&nbsp;</li>\n\t<li>In Nederland mogen bedrijven reclame maken voor koffie en thee. Er zijn wel nog andere regels.&nbsp;</li>\n</ol>", "DefaultChoices": false, "DataExportTag": "Q23", "QuestionType": "Slider", "Selector": "HSLIDER", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "above", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 8, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": false, "CustomStart": false, "NotApplicable": true, "MobileFirst": true}, "QuestionDescription": "Deel 1 – Wat vind jij van drugsbeleid?   Er zijn veel verschillende manieren om regels te maken v...", "Choices": {"1": {"Display": "ADHD-pillen"}, "4": {"Display": "Koffie en thee"}}, "ChoiceOrder": ["1", "4"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "CustomValidation", "CustomValidation": {"Logic": {"0": {"0": {"ChoiceLocator": "q://QID34/ChoiceNumericEntryValue/1", "Description": "<span class=\"ConjDesc\">If</span> <span class=\"QuestionDesc\">Deel 1 – Wat vind jij van drugsbeleid?\n&amp;nbsp;\n\nEr zijn veel verschillende manieren om regels te maken voor drugs.\n\n\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk ...</span> <span class=\"LeftOpDesc\">ADHD-pillen</span> <span class=\"OpDesc\">Is Greater Than</span> <span class=\"RightOpDesc\"> 31.25 </span>", "LeftOperand": "q://QID34/ChoiceNumericEntryValue/1", "LogicType": "Question", "Operator": "GreaterThan", "QuestionID": "QID34", "QuestionIDFromLocator": "QID34", "QuestionIsInLoop": "no", "RightOperand": "31.25", "Type": "Expression"}, "1": {"ChoiceLocator": "q://QID34/ChoiceNumericEntryValue/1", "Conjuction": "And", "Description": "<span class=\"ConjDesc\">And</span> <span class=\"QuestionDesc\">Deel 1 – Wat vind jij van drugsbeleid?\n&amp;nbsp;\n\nEr zijn veel verschillende manieren om regels te maken voor drugs.\n\n\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk ...</span> <span class=\"LeftOpDesc\">ADHD-pillen</span> <span class=\"OpDesc\">Is Less Than</span> <span class=\"RightOpDesc\"> 43.75 </span>", "LeftOperand": "q://QID34/ChoiceNumericEntryValue/1", "LogicType": "Question", "Operator": "LessThan", "QuestionID": "QID34", "QuestionIDFromLocator": "QID34", "QuestionIsInLoop": "no", "RightOperand": "43.75", "Type": "Expression"}, "2": {"ChoiceLocator": "q://QID34/ChoiceNumericEntryValue/4", "Conjuction": "And", "Description": "<span class=\"ConjDesc\">And</span> <span class=\"QuestionDesc\">Deel 1 – Wat vind jij van drugsbeleid?\n&amp;nbsp;\n\nEr zijn veel verschillende manieren om regels te maken voor drugs.\n\n\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk ...</span> <span class=\"LeftOpDesc\">Koffie en thee</span> <span class=\"OpDesc\">Is Greater Than</span> <span class=\"RightOpDesc\"> 81.25 </span>", "LeftOperand": "q://QID34/ChoiceNumericEntryValue/4", "LogicType": "Question", "Operator": "GreaterThan", "QuestionID": "QID34", "QuestionIDFromLocator": "QID34", "QuestionIsInLoop": "no", "RightOperand": "81.25", "Type": "Expression"}, "3": {"ChoiceLocator": "q://QID34/ChoiceNumericEntryValue/4", "Conjuction": "And", "Description": "<span class=\"ConjDesc\">And</span> <span class=\"QuestionDesc\">Deel 1 – Wat vind jij van drugsbeleid?\n&amp;nbsp;\n\nEr zijn veel verschillende manieren om regels te maken voor drugs.\n\n\nOp de volgende pagina zie je negen soorten drugs. Bij elke drug geef je aan welk ...</span> <span class=\"LeftOpDesc\">Koffie en thee</span> <span class=\"OpDesc\">Is Less Than</span> <span class=\"RightOpDesc\"> 93.75 </span>", "LeftOperand": "q://QID34/ChoiceNumericEntryValue/4", "LogicType": "Question", "Operator": "LessThan", "QuestionID": "QID34", "QuestionIDFromLocator": "QID34", "QuestionIsInLoop": "no", "RightOperand": "93.75", "Type": "Expression"}, "Type": "If"}, "Type": "BooleanExpression"}, "Message": {"description": "Error Text", "libraryID": "UR_1zx96MzQSykevWe", "messageID": "MS_QYNzOJeyLTJTNwU", "subMessageID": "VE_ERROR"}}}}, "GradingData": [], "Language": [], "NextChoiceId": 7, "NextAnswerId": 10, "Labels": {"1": {"Display": "verbod"}, "2": {"Display": "voor onderzoek"}, "3": {"Display": "voor behandeling"}, "4": {"Display": "op recept"}, "5": {"Display": "alleen in speciaalzaak, zonder winst"}, "6": {"Display": "alleen in speciaalzaak, met winst"}, "7": {"Display": "overal te koop, zonder reclame"}, "8": {"Display": "overal te koop, met reclame"}, "9": {"Display": "vrije verkoop"}, "NA": {"Display": "Geen mening"}}, "ChoiceDataExportTags": false, "QuestionID": "QID34", "QuestionJS": "// PNG icons (v2) embedded as data URIs, so nothing has to be uploaded to Qualtrics.\nvar EMOJI = {\n  verbod:         'data:image/png;base64,',\n  onderzoek:      'data:image/png;base64,',\n  behandeling:    'data:image/png;base64,',\n  recept:         'data:image/png;base64,',\n  speciaalzaak:   'data:image/png;base64,',\n  winst:          'data:image/png;base64,',\n  overal_te_koop: 'data:image/png;base64,',\n  reclame:        'data:image/png;base64,',\n  vrije_verkoop:  'data:image/png;base64,'\n};\n\n// Order of the icons from left (scale point 1) to right (scale point 9).\n// Change the order here if it doesn't match your scale.\nvar ORDER = ['verbod', 'onderzoek', 'behandeling', 'recept', 'speciaalzaak',\n             'winst', 'overal_te_koop', 'reclame', 'vrije_verkoop'];\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this.getQuestionContainer();\n\n  // icons in the question text: <span class=\"pol-icon\" data-icon=\"verbod\"></span> etc.\n  q.querySelectorAll('.pol-icon').forEach(function (el) {\n    var name = el.getAttribute('data-icon');\n    if (!EMOJI[name]) return;\n    el.innerHTML = '<img src=\"' + EMOJI[name] + '\" alt=\"\" style=\"width:1.4em;height:1.4em;' +\n                   'vertical-align:-0.35em;margin-right:6px;\">';\n  });\n  // \"Geen mening\" layout: right below the slider; no column labels on phones;\n  // white space moved from above the checkbox to below each drug\n  if (!document.getElementById('geen-mening-layout')) {\n    var css = document.createElement('style');\n    css.id = 'geen-mening-layout';\n    css.textContent = [\n      '.q-slider .slider-container { flex-wrap: wrap; align-items: flex-end; margin-bottom: 36px; }',\n      '.q-slider .slider-container > .statement-container > :not(.n-a-container) { flex: 0 0 100%; order: 0; }',\n      '.q-slider .slider-container .sliderGrid { order: 1; flex: 0 0 100%; width: 100%; }',\n      '.q-slider .slider-container .BarOuter { padding-bottom: 0 !important; }',\n      '.q-slider .slider-container .n-a-container { order: 2; flex: 0 0 100%; float: none;' +\n        ' margin: 6px 0 0 !important; padding: 0 !important; }',\n      '@media (max-width: 599px) {',\n      '  .q-slider .labels-container { display: none !important; }',   // no column labels on phones\n      '}'\n    ].join('\\n');\n    document.head.appendChild(css);\n  }\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  var q = this.getQuestionContainer();\n\n  // ---- Check for untouched sliders when the respondent clicks Next ----\n  var sliderRows = [];\n  var WARNING = 'Je hebt hier nog geen antwoord gegeven. Sleep het bolletje naar de regel die jij ' +\n                'het beste vindt, of vink ‘Geen mening’ aan.';\n  if (!document.getElementById('slider-warning-style')) {\n    var st = document.createElement('style');\n    st.id = 'slider-warning-style';\n    st.textContent =\n      '.slider-unanswered { outline: 2px solid #d32f2f; outline-offset: 6px; border-radius: 6px; }' +\n      '.slider-warning { order: 3; flex: 0 0 100%; color: #d32f2f; font-size: 0.9em; margin-top: 6px; }';\n    document.head.appendChild(st);\n  }\n  function clearWarning(row) {\n    row.classList.remove('slider-unanswered');\n    var w = row.querySelector('.slider-warning');\n    if (w) w.remove();\n  }\n  var checkNext = function (e) {\n    var btn = e.target.closest && e.target.closest('#NextButton, #next-button, .NextButton');\n    if (!btn) return;\n    var missing = sliderRows.filter(function (r) { return !r.answered(); });\n    if (!missing.length) return;\n    e.preventDefault();\n    e.stopPropagation();   // keeps Qualtrics from moving on; other questions on the page still get checked\n    missing.forEach(function (r) {\n      r.row.classList.add('slider-unanswered');\n      if (!r.row.querySelector('.slider-warning')) {\n        var w = document.createElement('div');\n        w.className = 'slider-warning';\n        w.textContent = WARNING;\n        r.row.appendChild(w);\n      }\n    });\n    if (!e.__sliderScrolled) {\n      e.__sliderScrolled = true;\n      missing[0].row.scrollIntoView({ behavior: 'smooth', block: 'center' });\n    }\n  };\n  document.addEventListener('click', checkNext, true);\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    document.removeEventListener('click', checkNext, true);\n  });\n\n  // Random VISUAL start position per slider. Only the handle is moved; no value is set,\n  // so an untouched slider stays unanswered (Force response still works). The start value\n  // is saved as embedded data \"start_<QID>_<row>\" (declare these fields in the Survey flow).\n  q.querySelectorAll('.track').forEach(function (bar) {\n    var host = bar.parentElement;\n    var handle = host.querySelector('.handle');\n    var fill = host.querySelector('.bar');\n    if (!handle) return;\n    var start = Math.round(Math.random() * 100);\n    var touched = false;\n    var row = bar.closest('.slider-container') || host;\n    var na = row.querySelector('input[type=checkbox]');\n    var rowInfo = { row: row, answered: function () { return touched || (na && na.checked); } };\n    sliderRows.push(rowInfo);\n    var put = function () {\n      if (touched) return;\n      var hw = handle.offsetWidth || 24;\n      var x = start / 100 * (bar.offsetWidth - hw);\n      handle.style.left = x + 'px';\n      if (fill) fill.style.width = x + 'px';\n    };\n    ['mousedown', 'touchstart', 'pointerdown', 'keydown'].forEach(function (ev) {\n      host.addEventListener(ev, function () { touched = true; clearWarning(row); }, true);\n    });\n    if (na) na.addEventListener('change', function () { if (na.checked) clearWarning(row); });\n    put();\n    setTimeout(put, 500);\n    window.addEventListener('resize', function () { setTimeout(put, 150); });\n    var m = (bar.className.match(/(QID\\d+)-(\\d+)-track/) || []);\n    if (m[1]) Qualtrics.SurveyEngine.setEmbeddedData('start_' + m[1] + '_' + m[2], start);\n  });\n\n  // sticky labels header\n  var labels = q.querySelector('.labels-container');\n  if (labels) {\n    var spacer = document.createElement('div');\n    spacer.style.display = 'none';\n    labels.parentNode.insertBefore(spacer, labels);\n    var stuck = false;\n    var sync = function () {\n      var qr = q.getBoundingClientRect();\n      var ref = (stuck ? spacer : labels).getBoundingClientRect();\n      var should = ref.top < 0 && qr.bottom > 100;\n      if (should && !stuck) {\n        var r = labels.getBoundingClientRect();\n        spacer.style.height = r.height + 'px';\n        spacer.style.display = 'block';\n        labels.style.cssText += ';position:fixed;top:0;left:' + r.left +\n          'px;width:' + r.width + 'px;background:#fff;z-index:100;';\n        stuck = true;\n      } else if (!should && stuck) {\n        ['position', 'top', 'left', 'width', 'zIndex'].forEach(function (p) {\n          labels.style[p] = '';\n        });\n        spacer.style.display = 'none';\n        stuck = false;\n      }\n    };\n    window.addEventListener('scroll', sync);\n    window.addEventListener('resize', sync);\n    sync();\n  }\n\n  // icons at each scale point; size scales with slider width\n  var place = function () {\n    q.querySelectorAll('.track').forEach(function (bar) {\n      var host = bar.parentElement;\n      host.querySelectorAll('.tick-emoji').forEach(function (e) { e.remove(); });\n      host.style.position = 'relative';\n\n      // let the edge icons stick out past the slider without being clipped\n      // (only containers that hide overflow; scrolling containers are left alone)\n      for (var el = host; el && el !== document.body; el = el.parentElement) {\n        var cs = getComputedStyle(el);\n        if (/auto|scroll/.test(cs.overflowX + cs.overflowY)) {\n          // scrolling container (needed on mobile): give it room for half an icon on each side\n          el.style.paddingLeft = el.style.paddingRight = '18px';\n          break;\n        }\n        if (/hidden|clip/.test(cs.overflowX + cs.overflowY)) el.style.overflow = 'visible';\n        if (cs.clipPath !== 'none') el.style.clipPath = 'none';\n        if (/paint|strict|content/.test(cs.contain)) el.style.contain = 'none';\n      }\n\n      var knob = host.querySelector('.handle, .ui-slider-handle, [class*=\"handle\"]');\n      // handle width; Qualtrics may hide the handle until first click, so fall back to its CSS width (24px)\n      var hw = (knob && (knob.offsetWidth || parseFloat(getComputedStyle(knob).width))) || 24;\n      var n = ORDER.length - 1;\n      var step = (bar.offsetWidth - hw) / n;\n      var size = Math.round(Math.max(16, Math.min(32, step * 0.7)));  // min 16px, max 32px\n\n      host.style.paddingTop = (size + 6) + 'px';\n      var left = bar.offsetLeft, top = bar.offsetTop - size - 4;\n\n      ORDER.forEach(function (name, i) {\n        var img = document.createElement('img');\n        img.className = 'tick-emoji';\n        img.src = EMOJI[name];\n        img.alt = '';\n        img.style.cssText =\n          'position:absolute;pointer-events:none;z-index:5;transform:translateX(-50%);' +\n          'width:' + size + 'px;height:' + size + 'px;' +\n          // position as a share of the bar width, so it stays right if the layout shifts after loading\n          'top:' + top + 'px;left:calc(' + (left + hw / 2) + 'px + (100% - ' + hw + 'px) * ' + (i / n) + ');';\n        host.appendChild(img);\n      });\n    });\n  };\n  place();\n  setTimeout(place, 500);   // redo once the page layout has settled\n  var timer;\n  window.addEventListener('resize', function () {\n    clearTimeout(timer);\n    timer = setTimeout(place, 100);\n  });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {});"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID35", "SecondaryAttribute": "What is your prolific ID?", "TertiaryAttribute": null, "Payload": {"QuestionText": "What is your prolific ID?", "DefaultChoices": {"TEXT": {"Text": "${e://Field/PROLIFIC_PID}"}}, "DataExportTag": "prolific_ID", "QuestionID": "QID35", "QuestionType": "TE", "Selector": "ML", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "What is your prolific ID?", "Validation": {"Settings": {"ForceResponse": "OFF", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "DisplayLogic": {"0": {"0": {"LogicType": "BooleanValue", "Value": "False", "Type": "Expression", "Description": "<span class=\"ConjDesc\">If</span><span> False</span>"}, "Type": "If"}, "Type": "BooleanExpression", "inPage": false}}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID36", "SecondaryAttribute": "Click to write the question text", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click to write the question text", "DefaultChoices": false, "DataExportTag": "Q23", "QuestionType": "TE", "Selector": "ML", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Click to write the question text", "Validation": {"Settings": {"ForceResponse": "OFF", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "QuestionID": "QID36"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID37", "SecondaryAttribute": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvo...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvoor anoniem bellen of chatten met de Drugs Infolijn via drugsinfo.nl of 0900-1995 (€0,10 per minuut).", "DefaultChoices": false, "DataExportTag": "Q24", "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvo...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID37"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID38", "SecondaryAttribute": "Kruis voor elk onderwerp aan welk gevoel je erbij hebt. Het gaat om hoe je over het onderwerp voe...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Kruis voor elk onderwerp aan welk gevoel je erbij hebt. Het gaat om hoe je over het onderwerp voelt, niet om hoe je je voelt als je het gebruikt. <br><br><i style=\"\">Let op</i>:<i> </i>meerdere antwoorden per onderwerp mogen. Kies 'geen van deze' als je niets voelt.", "QuestionJS": false, "DefaultChoices": false, "DataExportTag": "Q25", "QuestionType": "Matrix", "Selector": "Likert", "SubSelector": "MultipleAnswer", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "WhiteSpace": "OFF", "MobileFirst": true}, "QuestionDescription": "Kruis voor elk onderwerp aan welk gevoel je erbij hebt. Het gaat om hoe je over het onderwerp voe...", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabak"}, "3": {"Display": "softdrugs"}, "4": {"Display": "harddrugs"}, "5": {"Display": "drugsbeleid"}}, "ChoiceOrder": [1, 2, 3, 4, 5], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": {"DE": {"QuestionText": "Kreuze für jedes Thema an, welche Emotionen es bei dir hervorruft. <b>Achtung</b>:<i> mehrere Antworten pro Thema sind erlaubt</i>. Wähle 'keine davon', wenn du nichts empfindest.", "Choices": {"1": {"Display": "Alkohol"}, "2": {"Display": "Tabak"}, "3": {"Display": "weiche Drogen"}, "4": {"Display": "harte Drogen"}, "5": {"Display": "Drogenpolitik"}}, "Answers": {"1": {"Display": "Wut"}, "2": {"Display": "Angst / Sorge"}, "3": {"Display": "Hoffnung"}, "4": {"Display": "Freude"}, "5": {"Display": "keine davon"}}}, "EN-GB": {"QuestionText": "For each topic, tick the emotions it evokes in you. <b>Note</b>:<i> multiple answers per topic are allowed</i>. Choose 'none of these' if you do not feel anything.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tobacco"}, "3": {"Display": "soft drugs"}, "4": {"Display": "hard drugs"}, "5": {"Display": "drug policy"}}, "Answers": {"1": {"Display": "angry"}, "2": {"Display": "afraid / worried"}, "3": {"Display": "hopeful"}, "4": {"Display": "happy"}, "5": {"Display": "none of these"}}}, "ES": {"QuestionText": "Marca para cada tema qué emociones te evoca. <b>Atención</b>:<i> se permiten varias respuestas por tema</i>. Elige 'ninguna de estas' si no sientes nada.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas blandas"}, "4": {"Display": "drogas duras"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "enojo"}, "2": {"Display": "miedo / preocupación"}, "3": {"Display": "esperanza"}, "4": {"Display": "alegría"}, "5": {"Display": "ninguna de estas"}}}, "ES-ES": {"QuestionText": "Marca para cada tema qué emociones te evoca. <b>Atención</b>:<i> se permiten varias respuestas por tema</i>. Elige 'ninguna de estas' si no sientes nada.", "Choices": {"1": {"Display": "alcohol"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas blandas"}, "4": {"Display": "drogas duras"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "enfado"}, "2": {"Display": "miedo / preocupación"}, "3": {"Display": "esperanza"}, "4": {"Display": "alegría"}, "5": {"Display": "ninguna de estas"}}}, "FR": {"QuestionText": "Pour chaque sujet, cochez les émotions qu’il évoque en vous. <b>Attention</b>:<i> plusieurs réponses par sujet sont autorisées</i>. Choisissez 'aucune de celles-ci' si vous ne ressentez rien.", "Choices": {"1": {"Display": "alcool"}, "2": {"Display": "tabac"}, "3": {"Display": "drogues douces"}, "4": {"Display": "drogues dures"}, "5": {"Display": "politique des drogues"}}, "Answers": {"1": {"Display": "colère"}, "2": {"Display": "peur / inquiétude"}, "3": {"Display": "espoir"}, "4": {"Display": "joie"}, "5": {"Display": "aucune de celles-ci"}}}, "IT": {"QuestionText": "Per ogni tema, segna le emozioni che suscita in te. <b>Attenzione</b>:<i> sono consentite più risposte per tema</i>. Scegli 'nessuna di queste' se non provi nulla.", "Choices": {"1": {"Display": "alcol"}, "2": {"Display": "tabacco"}, "3": {"Display": "droghe leggere"}, "4": {"Display": "droghe pesanti"}, "5": {"Display": "politica sulle droghe"}}, "Answers": {"1": {"Display": "rabbia"}, "2": {"Display": "paura / preoccupazione"}, "3": {"Display": "speranza"}, "4": {"Display": "gioia"}, "5": {"Display": "nessuna di queste"}}}, "PT": {"QuestionText": "Assinale, para cada tema, as emoções que ele desperta. <b>Atenção</b>:<i> são permitidas várias respostas por tema</i>. Escolha 'nenhuma destas' se não sentir nada.", "Choices": {"1": {"Display": "álcool"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas leves"}, "4": {"Display": "drogas pesadas"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "raiva"}, "2": {"Display": "medo / preocupação"}, "3": {"Display": "esperança"}, "4": {"Display": "alegria"}, "5": {"Display": "nenhuma destas"}}}, "PT-BR": {"QuestionText": "Marque, para cada tema, as emoções que ele desperta. <b>Atenção</b>:<i> são permitidas várias respostas por tema</i>. Escolha 'nenhuma destas' se você não sentir nada.", "Choices": {"1": {"Display": "álcool"}, "2": {"Display": "tabaco"}, "3": {"Display": "drogas leves"}, "4": {"Display": "drogas pesadas"}, "5": {"Display": "política de drogas"}}, "Answers": {"1": {"Display": "raiva"}, "2": {"Display": "medo / preocupação"}, "3": {"Display": "esperança"}, "4": {"Display": "alegria"}, "5": {"Display": "nenhuma destas"}}}}, "NextChoiceId": 6, "NextAnswerId": 6, "Answers": {"1": {"Display": "boos"}, "2": {"Display": "bang / bezorgd"}, "3": {"Display": "hoop"}, "4": {"Display": "blij"}, "5": {"Display": "geen van deze", "ExclusiveAnswer": true}}, "AnswerOrder": [1, 2, 3, 4, 5], "ChoiceDataExportTags": false, "QuestionID": "QID38"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID39", "SecondaryAttribute": "Click to write the question text", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click to write the question text", "DefaultChoices": false, "DataExportTag": "Q26", "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Click to write the question text", "Choices": {"1": {"Display": "Click to write Choice 1"}, "2": {"Display": "Click to write Choice 2"}, "3": {"Display": "Click to write Choice 3"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "OFF", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID39"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID4", "SecondaryAttribute": "Welk beleid vind jij het beste? Sleep de schuifbalk naar de regel die jij het beste vindt voor di...", "TertiaryAttribute": null, "Payload": {"QuestionText": "<p><b>Welk beleid vind jij het beste?</b><br>\nSleep de schuifbalk naar de regel die jij het beste vindt voor die drug. Onderaan de pagina worden de negen regels nog eens beschreven.&nbsp;<br></p><p>&nbsp;</p>", "QuestionText_Unsafe": "<p><b>Welk beleid heeft jouw voorkeur voor elk van de onderstaande categorie&euml;n?</b><br/>Sleep de schuifbalk naar de gewenste plek (0 = Verbod, 20 = Verbod op verkoop, 40 = Verkoop zonder winst, 60 = Verkoop met winst zonder marketing, 80 = Verkoop met marketing, 100 = Vrije verkoop).</p>", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 8, "CustomStart": false, "NotApplicable": true, "SnapToGrid": false, "NumDecimals": 0, "ShowValue": false, "MobileFirst": true}, "QuestionDescription": "Welk beleid vind jij het beste? Sleep de schuifbalk naar de regel die jij het beste vindt voor di...", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "<p><b>Welche Politik bevorzugst du für jede der folgenden Kategorien?</b><br>\nZiehe den Schieberegler an die gewünschte Stelle.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alkohol"}, "2": {"Display": "Tabak"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychedelika"}, "5": {"Display": "MDMA (Ecstasy)"}, "6": {"Display": "Kokain / Crack"}, "7": {"Display": "Speed (Amphetamin)"}, "8": {"Display": "Heroin"}, "9": {"Display": "Starke Schmerzmittel und Schlafmittel"}}, "Labels": {"1": {"Display": "Verbot"}, "2": {"Display": "Verkaufsverbot"}, "3": {"Display": "Verbot, nur medizinisch"}, "4": {"Display": "Verkauf ohne Gewinn"}, "5": {"Display": "Verkauf mit Gewinn, ohne Marketing"}, "6": {"Display": "Verkauf mit Marketing"}, "7": {"Display": "unregulierter Verkauf"}, "NA": {"Display": "Keine Meinung"}}}, "EN-GB": {"QuestionText": "<p><b>Which policy do you prefer for each of the categories below?</b><br>\nDrag the slider to the desired position.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Tobacco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychedelics"}, "5": {"Display": "MDMA (ecstasy)"}, "6": {"Display": "Cocaine / crack"}, "7": {"Display": "Speed (amphetamine)"}, "8": {"Display": "Heroin"}, "9": {"Display": "Heavy painkillers and sleeping medication"}}, "Labels": {"1": {"Display": "prohibition"}, "2": {"Display": "ban on sales"}, "3": {"Display": "prohibition, medical only"}, "4": {"Display": "non-profit sales"}, "5": {"Display": "for-profit sales, without marketing"}, "6": {"Display": "sales with marketing"}, "7": {"Display": "unregulated sale"}, "NA": {"Display": "No opinion"}}}, "ES": {"QuestionText": "<p><b>¿Qué política prefieres para cada una de las siguientes categorías?</b><br>\nArrastra el control deslizante hasta la posición deseada.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Tabaco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}, "5": {"Display": "MDMA (éxtasis)"}, "6": {"Display": "Cocaína / crack"}, "7": {"Display": "Speed (anfetamina)"}, "8": {"Display": "Heroína"}, "9": {"Display": "Analgésicos y somníferos fuertes"}}, "Labels": {"1": {"Display": "prohibición"}, "2": {"Display": "prohibición de la venta"}, "3": {"Display": "prohibición, solo uso médico"}, "4": {"Display": "venta sin fines de lucro"}, "5": {"Display": "venta con fines de lucro, sin marketing"}, "6": {"Display": "venta con marketing"}, "7": {"Display": "venta no regulada"}, "NA": {"Display": "Sin opinión"}}}, "ES-ES": {"QuestionText": "<p><b>¿Qué política prefieres para cada una de las siguientes categorías?</b><br>\nArrastra el control deslizante hasta la posición deseada.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Tabaco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}, "5": {"Display": "MDMA (éxtasis)"}, "6": {"Display": "Cocaína / crack"}, "7": {"Display": "Speed (anfetamina)"}, "8": {"Display": "Heroína"}, "9": {"Display": "Analgésicos y somníferos fuertes"}}, "Labels": {"1": {"Display": "prohibición"}, "2": {"Display": "prohibición de la venta"}, "3": {"Display": "prohibición, solo uso médico"}, "4": {"Display": "venta sin ánimo de lucro"}, "5": {"Display": "venta con ánimo de lucro, sin marketing"}, "6": {"Display": "venta con marketing"}, "7": {"Display": "venta no regulada"}, "NA": {"Display": "Sin opinión"}}}, "FR": {"QuestionText": "<p><b>Quelle politique préférez-vous pour chacune des catégories ci-dessous ?</b><br>\nFaites glisser le curseur jusqu’à la position souhaitée.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alcool"}, "2": {"Display": "Tabac"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychédéliques"}, "5": {"Display": "MDMA (ecstasy)"}, "6": {"Display": "Cocaïne / crack"}, "7": {"Display": "Speed (amphétamine)"}, "8": {"Display": "Héroïne"}, "9": {"Display": "Analgésiques et somnifères puissants"}}, "Labels": {"1": {"Display": "interdiction"}, "2": {"Display": "interdiction de la vente"}, "3": {"Display": "interdiction, usage médical uniquement"}, "4": {"Display": "vente sans but lucratif"}, "5": {"Display": "vente à but lucratif, sans marketing"}, "6": {"Display": "vente avec marketing"}, "7": {"Display": "vente non réglementée"}, "NA": {"Display": "Sans opinion"}}}, "IT": {"QuestionText": "<p><b>Quale politica preferisci per ciascuna delle categorie qui sotto?</b><br>\nTrascina il cursore nella posizione desiderata.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Alcol"}, "2": {"Display": "Tabacco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psichedelici"}, "5": {"Display": "MDMA (ecstasy)"}, "6": {"Display": "Cocaina / crack"}, "7": {"Display": "Speed (anfetamina)"}, "8": {"Display": "Eroina"}, "9": {"Display": "Antidolorifici e sonniferi forti"}}, "Labels": {"1": {"Display": "proibizione"}, "2": {"Display": "divieto di vendita"}, "3": {"Display": "proibizione, solo uso medico"}, "4": {"Display": "vendita senza scopo di lucro"}, "5": {"Display": "vendita a scopo di lucro, senza marketing"}, "6": {"Display": "vendita con marketing"}, "7": {"Display": "vendita non regolamentata"}, "NA": {"Display": "Nessuna opinione"}}}, "PT": {"QuestionText": "<p><b>Qual política prefere para cada uma das categorias abaixo?</b><br>\nArraste o cursor até à posição desejada.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Álcool"}, "2": {"Display": "Tabaco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}, "5": {"Display": "MDMA (ecstasy)"}, "6": {"Display": "Cocaína / crack"}, "7": {"Display": "Speed (anfetamina)"}, "8": {"Display": "Heroína"}, "9": {"Display": "Analgésicos e soníferos fortes"}}, "Labels": {"1": {"Display": "proibição"}, "2": {"Display": "proibição da venda"}, "3": {"Display": "proibição, apenas uso médico"}, "4": {"Display": "venda sem fins lucrativos"}, "5": {"Display": "venda com fins lucrativos, sem marketing"}, "6": {"Display": "venda com marketing"}, "7": {"Display": "venda não regulamentada"}, "NA": {"Display": "Sem opinião"}}}, "PT-BR": {"QuestionText": "<p><b>Qual política você prefere para cada uma das categorias abaixo?</b><br>\nArraste o cursor até a posição desejada.<br></p><p>&nbsp;</p>", "Choices": {"1": {"Display": "Álcool"}, "2": {"Display": "Tabaco"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psicodélicos"}, "5": {"Display": "MDMA (ecstasy)"}, "6": {"Display": "Cocaína / crack"}, "7": {"Display": "Speed (anfetamina)"}, "8": {"Display": "Heroína"}, "9": {"Display": "Analgésicos e soníferos fortes"}}, "Labels": {"1": {"Display": "proibição"}, "2": {"Display": "proibição da venda"}, "3": {"Display": "proibição, apenas uso médico"}, "4": {"Display": "venda sem fins lucrativos"}, "5": {"Display": "venda com fins lucrativos, sem marketing"}, "6": {"Display": "venda com marketing"}, "7": {"Display": "venda não regulamentada"}, "NA": {"Display": "Sem opinião"}}}}, "QuestionID": "QID4", "DataExportTag": "beleid_voorkeur", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 10, "NextAnswerId": 10, "Choices": {"1": {"Display": "Alcohol"}, "2": {"Display": "Tabak (of vapes)"}, "3": {"Display": "Cannabis"}, "4": {"Display": "Psychedelica (zoals paddos en LSD)"}, "5": {"Display": "MDMA (XTC)"}, "6": {"Display": "Cocaïne / crack"}, "7": {"Display": "Speed (amphetamine)"}, "8": {"Display": "Heroïne"}, "9": {"Display": "Zware pijnstillers"}}, "ChoiceOrder": [1, 2, 3, 4, 5, 6, 7, 8, 9], "Labels": {"1": {"Display": "verbod"}, "2": {"Display": "alleen voor onderzoek"}, "3": {"Display": "alleen als behandeling"}, "4": {"Display": "alleen op recept"}, "5": {"Display": "alleen in speciaalzaak, zonder winst"}, "6": {"Display": "alleen in speciaalzaak, met winst"}, "7": {"Display": "overal te koop, zonder reclame"}, "8": {"Display": "overal te koop, met reclame"}, "9": {"Display": "vrije verkoop"}, "NA": {"Display": "Geen mening"}}, "ChoiceDataExportTags": false, "Randomization": {"Advanced": null, "ConsistentScaleReversal": true, "TotalRandSubset": "", "Type": "All"}, "QuestionJS": "// PNG icons (v2) embedded as data URIs, so nothing has to be uploaded to Qualtrics.\nvar EMOJI = {\n  verbod:         'data:image/png;base64,',\n  onderzoek:      'data:image/png;base64,',\n  behandeling:    'data:image/png;base64,',\n  recept:         'data:image/png;base64,',\n  speciaalzaak:   'data:image/png;base64,',\n  winst:          'data:image/png;base64,',\n  overal_te_koop: 'data:image/png;base64,',\n  reclame:        'data:image/png;base64,',\n  vrije_verkoop:  'data:image/png;base64,'\n};\n\n// Order of the icons from left (scale point 1) to right (scale point 9).\n// Change the order here if it doesn't match your scale.\nvar ORDER = ['verbod', 'onderzoek', 'behandeling', 'recept', 'speciaalzaak',\n             'winst', 'overal_te_koop', 'reclame', 'vrije_verkoop'];\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this.getQuestionContainer();\n\n  // icons in the question text: <span class=\"pol-icon\" data-icon=\"verbod\"></span> etc.\n  q.querySelectorAll('.pol-icon').forEach(function (el) {\n    var name = el.getAttribute('data-icon');\n    if (!EMOJI[name]) return;\n    el.innerHTML = '<img src=\"' + EMOJI[name] + '\" alt=\"\" style=\"width:1.4em;height:1.4em;' +\n                   'vertical-align:-0.35em;margin-right:6px;\">';\n  });\n  // \"Geen mening\" layout: right below the slider; no column labels on phones;\n  // white space moved from above the checkbox to below each drug\n  if (!document.getElementById('geen-mening-layout')) {\n    var css = document.createElement('style');\n    css.id = 'geen-mening-layout';\n    css.textContent = [\n      '.q-slider .slider-container { flex-wrap: wrap; align-items: flex-end; margin-bottom: 36px; }',\n      '.q-slider .slider-container > .statement-container > :not(.n-a-container) { flex: 0 0 100%; order: 0; }',\n      '.q-slider .slider-container .sliderGrid { order: 1; flex: 0 0 100%; width: 100%; }',\n      '.q-slider .slider-container .BarOuter { padding-bottom: 0 !important; }',\n      '.q-slider .slider-container .n-a-container { order: 2; flex: 0 0 100%; float: none;' +\n        ' margin: 6px 0 0 !important; padding: 0 !important; }',\n      '@media (max-width: 599px) {',\n      '  .q-slider .labels-container { display: none !important; }',   // no column labels on phones\n      '}'\n    ].join('\\n');\n    document.head.appendChild(css);\n  }\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  var q = this.getQuestionContainer();\n\n  // ---- Check for untouched sliders when the respondent clicks Next ----\n  var sliderRows = [];\n  var WARNING = 'Je hebt hier nog geen antwoord gegeven. Sleep het bolletje naar de regel die jij ' +\n                'het beste vindt, of vink ‘Geen mening’ aan.';\n  if (!document.getElementById('slider-warning-style')) {\n    var st = document.createElement('style');\n    st.id = 'slider-warning-style';\n    st.textContent =\n      '.slider-unanswered { outline: 2px solid #d32f2f; outline-offset: 6px; border-radius: 6px; }' +\n      '.slider-warning { order: 3; flex: 0 0 100%; color: #d32f2f; font-size: 0.9em; margin-top: 6px; }';\n    document.head.appendChild(st);\n  }\n  function clearWarning(row) {\n    row.classList.remove('slider-unanswered');\n    var w = row.querySelector('.slider-warning');\n    if (w) w.remove();\n  }\n  var checkNext = function (e) {\n    var btn = e.target.closest && e.target.closest('#NextButton, #next-button, .NextButton');\n    if (!btn) return;\n    var missing = sliderRows.filter(function (r) { return !r.answered(); });\n    if (!missing.length) return;\n    e.preventDefault();\n    e.stopPropagation();   // keeps Qualtrics from moving on; other questions on the page still get checked\n    missing.forEach(function (r) {\n      r.row.classList.add('slider-unanswered');\n      if (!r.row.querySelector('.slider-warning')) {\n        var w = document.createElement('div');\n        w.className = 'slider-warning';\n        w.textContent = WARNING;\n        r.row.appendChild(w);\n      }\n    });\n    if (!e.__sliderScrolled) {\n      e.__sliderScrolled = true;\n      missing[0].row.scrollIntoView({ behavior: 'smooth', block: 'center' });\n    }\n  };\n  document.addEventListener('click', checkNext, true);\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    document.removeEventListener('click', checkNext, true);\n  });\n\n  // Random VISUAL start position per slider. Only the handle is moved; no value is set,\n  // so an untouched slider stays unanswered (Force response still works). The start value\n  // is saved as embedded data \"start_<QID>_<row>\" (declare these fields in the Survey flow).\n  q.querySelectorAll('.track').forEach(function (bar) {\n    var host = bar.parentElement;\n    var handle = host.querySelector('.handle');\n    var fill = host.querySelector('.bar');\n    if (!handle) return;\n    var start = Math.round(Math.random() * 100);\n    var touched = false;\n    var row = bar.closest('.slider-container') || host;\n    var na = row.querySelector('input[type=checkbox]');\n    var rowInfo = { row: row, answered: function () { return touched || (na && na.checked); } };\n    sliderRows.push(rowInfo);\n    var put = function () {\n      if (touched) return;\n      var hw = handle.offsetWidth || 24;\n      var x = start / 100 * (bar.offsetWidth - hw);\n      handle.style.left = x + 'px';\n      if (fill) fill.style.width = x + 'px';\n    };\n    ['mousedown', 'touchstart', 'pointerdown', 'keydown'].forEach(function (ev) {\n      host.addEventListener(ev, function () { touched = true; clearWarning(row); }, true);\n    });\n    if (na) na.addEventListener('change', function () { if (na.checked) clearWarning(row); });\n    put();\n    setTimeout(put, 500);\n    window.addEventListener('resize', function () { setTimeout(put, 150); });\n    var m = (bar.className.match(/(QID\\d+)-(\\d+)-track/) || []);\n    if (m[1]) Qualtrics.SurveyEngine.setEmbeddedData('start_' + m[1] + '_' + m[2], start);\n  });\n\n  // sticky labels header\n  var labels = q.querySelector('.labels-container');\n  if (labels) {\n    var spacer = document.createElement('div');\n    spacer.style.display = 'none';\n    labels.parentNode.insertBefore(spacer, labels);\n    var stuck = false;\n    var sync = function () {\n      var qr = q.getBoundingClientRect();\n      var ref = (stuck ? spacer : labels).getBoundingClientRect();\n      var should = ref.top < 0 && qr.bottom > 100;\n      if (should && !stuck) {\n        var r = labels.getBoundingClientRect();\n        spacer.style.height = r.height + 'px';\n        spacer.style.display = 'block';\n        labels.style.cssText += ';position:fixed;top:0;left:' + r.left +\n          'px;width:' + r.width + 'px;background:#fff;z-index:100;';\n        stuck = true;\n      } else if (!should && stuck) {\n        ['position', 'top', 'left', 'width', 'zIndex'].forEach(function (p) {\n          labels.style[p] = '';\n        });\n        spacer.style.display = 'none';\n        stuck = false;\n      }\n    };\n    window.addEventListener('scroll', sync);\n    window.addEventListener('resize', sync);\n    sync();\n  }\n\n  // icons at each scale point; size scales with slider width\n  var place = function () {\n    q.querySelectorAll('.track').forEach(function (bar) {\n      var host = bar.parentElement;\n      host.querySelectorAll('.tick-emoji').forEach(function (e) { e.remove(); });\n      host.style.position = 'relative';\n\n      // let the edge icons stick out past the slider without being clipped\n      // (only containers that hide overflow; scrolling containers are left alone)\n      for (var el = host; el && el !== document.body; el = el.parentElement) {\n        var cs = getComputedStyle(el);\n        if (/auto|scroll/.test(cs.overflowX + cs.overflowY)) {\n          // scrolling container (needed on mobile): give it room for half an icon on each side\n          el.style.paddingLeft = el.style.paddingRight = '18px';\n          break;\n        }\n        if (/hidden|clip/.test(cs.overflowX + cs.overflowY)) el.style.overflow = 'visible';\n        if (cs.clipPath !== 'none') el.style.clipPath = 'none';\n        if (/paint|strict|content/.test(cs.contain)) el.style.contain = 'none';\n      }\n\n      var knob = host.querySelector('.handle, .ui-slider-handle, [class*=\"handle\"]');\n      // handle width; Qualtrics may hide the handle until first click, so fall back to its CSS width (24px)\n      var hw = (knob && (knob.offsetWidth || parseFloat(getComputedStyle(knob).width))) || 24;\n      var n = ORDER.length - 1;\n      var step = (bar.offsetWidth - hw) / n;\n      var size = Math.round(Math.max(16, Math.min(32, step * 0.7)));  // min 16px, max 32px\n\n      host.style.paddingTop = (size + 6) + 'px';\n      var left = bar.offsetLeft, top = bar.offsetTop - size - 4;\n\n      ORDER.forEach(function (name, i) {\n        var img = document.createElement('img');\n        img.className = 'tick-emoji';\n        img.src = EMOJI[name];\n        img.alt = '';\n        img.style.cssText =\n          'position:absolute;pointer-events:none;z-index:5;transform:translateX(-50%);' +\n          'width:' + size + 'px;height:' + size + 'px;' +\n          // position as a share of the bar width, so it stays right if the layout shifts after loading\n          'top:' + top + 'px;left:calc(' + (left + hw / 2) + 'px + (100% - ' + hw + 'px) * ' + (i / n) + ');';\n        host.appendChild(img);\n      });\n    });\n  };\n  place();\n  setTimeout(place, 500);   // redo once the page layout has settled\n  var timer;\n  window.addEventListener('resize', function () {\n    clearTimeout(timer);\n    timer = setTimeout(place, 100);\n  });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {});"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID40", "SecondaryAttribute": "Click to write the question text", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click to write the question text", "DefaultChoices": false, "DataExportTag": "Q27", "QuestionType": "Matrix", "Selector": "Likert", "SubSelector": "SingleAnswer", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "WhiteSpace": "OFF", "MobileFirst": true}, "QuestionDescription": "Click to write the question text", "Choices": {"1": {"Display": "Click to write Statement 1"}, "2": {"Display": "Click to write Statement 2"}, "3": {"Display": "Click to write Statement 3"}}, "ChoiceOrder": ["1", "2", "3"], "Validation": {"Settings": {"ForceResponse": "OFF", "Type": "None"}}, "GradingData": [], "Lan