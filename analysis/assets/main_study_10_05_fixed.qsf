ahre"}, "3": {"Display": "35–44 Jahre"}, "4": {"Display": "45–54 Jahre"}, "5": {"Display": "55–64 Jahre"}, "6": {"Display": "65–74 Jahre"}}}, "EN-GB": {"QuestionText": "What is your age?", "Choices": {"1": {"Display": "18–24 years"}, "2": {"Display": "25–34 years"}, "3": {"Display": "35–44 years"}, "4": {"Display": "45–54 years"}, "5": {"Display": "55–64 years"}, "6": {"Display": "65–74 years"}}}, "ES": {"QuestionText": "¿Cuál es tu edad?", "Choices": {"1": {"Display": "18–24 años"}, "2": {"Display": "25–34 años"}, "3": {"Display": "35–44 años"}, "4": {"Display": "45–54 años"}, "5": {"Display": "55–64 años"}, "6": {"Display": "65–74 años"}}}, "ES-ES": {"QuestionText": "¿Cuál es tu edad?", "Choices": {"1": {"Display": "18–24 años"}, "2": {"Display": "25–34 años"}, "3": {"Display": "35–44 años"}, "4": {"Display": "45–54 años"}, "5": {"Display": "55–64 años"}, "6": {"Display": "65–74 años"}}}, "FR": {"QuestionText": "Quel est votre âge ?", "Choices": {"1": {"Display": "18–24 ans"}, "2": {"Display": "25–34 ans"}, "3": {"Display": "35–44 ans"}, "4": {"Display": "45–54 ans"}, "5": {"Display": "55–64 ans"}, "6": {"Display": "65–74 ans"}}}, "IT": {"QuestionText": "Qual è la tua età?", "Choices": {"1": {"Display": "18–24 anni"}, "2": {"Display": "25–34 anni"}, "3": {"Display": "35–44 anni"}, "4": {"Display": "45–54 anni"}, "5": {"Display": "55–64 anni"}, "6": {"Display": "65–74 anni"}}}, "PT": {"QuestionText": "Qual é a sua idade?", "Choices": {"1": {"Display": "18–24 anos"}, "2": {"Display": "25–34 anos"}, "3": {"Display": "35–44 anos"}, "4": {"Display": "45–54 anos"}, "5": {"Display": "55–64 anos"}, "6": {"Display": "65–74 anos"}}}, "PT-BR": {"QuestionText": "Qual é a sua idade?", "Choices": {"1": {"Display": "18–24 anos"}, "2": {"Display": "25–34 anos"}, "3": {"Display": "35–44 anos"}, "4": {"Display": "45–54 anos"}, "5": {"Display": "55–64 anos"}, "6": {"Display": "65–74 anos"}}}}, "NextChoiceId": 8, "NextAnswerId": 1, "QuestionID": "QID44"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID45", "SecondaryAttribute": "Click to write the question text", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click to write the question text", "DefaultChoices": false, "DataExportTag": "Q32", "QuestionType": "TE", "Selector": "ML", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Click to write the question text", "Validation": {"Settings": {"ForceResponse": "OFF", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "QuestionID": "QID45"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID46", "SecondaryAttribute": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvo...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvoor anoniem bellen of chatten met de Drugs Infolijn via drugsinfo.nl of 0900-1995 (€0,10 per minuut).", "DefaultChoices": false, "DataExportTag": "Q33", "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Heb je na het invullen vragen over je eigen drugsgebruik of dat van iemand anders? Je kunt daarvo...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID46"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID47", "SecondaryAttribute": "​Verbod – Verkopen, kopen en bezitten is verboden. Niemand mag het krijgen. ​Alleen voor onder", "TertiaryAttribute": null, "Payload": {"QuestionText": "\n<ol>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"verbod\">​</span><b>Verbod – </b>Verkopen, kopen en bezitten is verboden. Niemand mag het krijgen.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"onderzoek\">​</span><b>Alleen voor onderzoek – </b>Alleen onderzoekers mogen het gebruiken voor wetenschappelijk onderzoek. Verder blijft het verboden.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"behandeling\">​</span><b>Alleen als behandeling – </b>Alleen mensen die ernstig ziek of verslaafd zijn, kunnen het van een arts krijgen.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"recept\">​</span><b>Alleen op recept – </b>Een arts mag het voorschrijven aan iedereen die er baat bij heeft.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"speciaalzaak\">​</span><b>Alleen in speciaalzaak, zonder winst – </b>Alleen speciale winkels voor dit middel mogen het verkopen. Deze winkels mogen er geen winst op maken.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"winst\">​</span><b>Alleen in speciaalzaak, met winst – </b>Alleen speciale winkels voor dit middel mogen het verkopen. Deze winkels mogen er wel winst op maken.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"overal_te_koop\">​</span><b>Overal te koop, zonder reclame – </b>Ook gewone winkels en horeca mogen het verkopen en er winst op maken. Reclame maken mag niet.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"reclame\">​</span><b>Overal te koop, met reclame – </b>Ook gewone winkels en horeca mogen het verkopen en er winst op maken. Reclame maken mag wel.</p>\n\t</li>\n\t<li>\n\t<p><span class=\"pol-icon\" data-icon=\"vrije_verkoop\">​</span><b>Vrije verkoop – </b>Iedereen mag het verkopen. Er zijn geen speciale regels.</p>\n\t</li>\n</ol>", "DefaultChoices": false, "DataExportTag": "Q34", "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "​Verbod – Verkopen, kopen en bezitten is verboden. Niemand mag het krijgen. ​Alleen voor onderzoe...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID47", "QuestionJS": "// PNG icons (v2) embedded as data URIs, so nothing has to be uploaded to Qualtrics.\nvar EMOJI = {\n  verbod:         'data:image/png;base64,',\n  onderzoek:      'data:image/png;base64,',\n  behandeling:    'data:image/png;base64,',\n  recept:         'data:image/png;base64,',\n  speciaalzaak:   'data:image/png;base64,',\n  winst:          'data:image/png;base64,',\n  overal_te_koop: 'data:image/png;base64,',\n  reclame:        'data:image/png;base64,',\n  vrije_verkoop:  'data:image/png;base64,'\n};\n\n// Order of the icons from left (scale point 1) to right (scale point 9).\n// Change the order here if it doesn't match your scale.\nvar ORDER = ['verbod', 'onderzoek', 'behandeling', 'recept', 'speciaalzaak',\n             'winst', 'overal_te_koop', 'reclame', 'vrije_verkoop'];\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this.getQuestionContainer();\n\n  // icons in the question text: <span class=\"pol-icon\" data-icon=\"verbod\"></span> etc.\n  q.querySelectorAll('.pol-icon').forEach(function (el) {\n    var name = el.getAttribute('data-icon');\n    if (!EMOJI[name]) return;\n    el.innerHTML = '<img src=\"' + EMOJI[name] + '\" alt=\"\" style=\"width:1.4em;height:1.4em;' +\n                   'vertical-align:-0.35em;margin-right:6px;\">';\n  });\n  // \"Geen mening\" layout: right below the slider; no column labels on phones;\n  // white space moved from above the checkbox to below each drug\n  if (!document.getElementById('geen-mening-layout')) {\n    var css = document.createElement('style');\n    css.id = 'geen-mening-layout';\n    css.textContent = [\n      '.q-slider .slider-container { flex-wrap: wrap; align-items: flex-end; margin-bottom: 36px; }',\n      '.q-slider .slider-container > .statement-container > :not(.n-a-container) { flex: 0 0 100%; order: 0; }',\n      '.q-slider .slider-container .sliderGrid { order: 1; flex: 0 0 100%; width: 100%; }',\n      '.q-slider .slider-container .BarOuter { padding-bottom: 0 !important; }',\n      '.q-slider .slider-container .n-a-container { order: 2; flex: 0 0 100%; float: none;' +\n        ' margin: 6px 0 0 !important; padding: 0 !important; }',\n      '@media (max-width: 599px) {',\n      '  .q-slider .labels-container { display: none !important; }',   // no column labels on phones\n      '}'\n    ].join('\\n');\n    document.head.appendChild(css);\n  }\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  var q = this.getQuestionContainer();\n\n  // ---- Check for untouched sliders when the respondent clicks Next ----\n  var sliderRows = [];\n  var WARNING = 'Je hebt hier nog geen antwoord gegeven. Sleep het bolletje naar de regel die jij ' +\n                'het beste vindt, of vink ‘Geen mening’ aan.';\n  if (!document.getElementById('slider-warning-style')) {\n    var st = document.createElement('style');\n    st.id = 'slider-warning-style';\n    st.textContent =\n      '.slider-unanswered { outline: 2px solid #d32f2f; outline-offset: 6px; border-radius: 6px; }' +\n      '.slider-warning { order: 3; flex: 0 0 100%; color: #d32f2f; font-size: 0.9em; margin-top: 6px; }';\n    document.head.appendChild(st);\n  }\n  function clearWarning(row) {\n    row.classList.remove('slider-unanswered');\n    var w = row.querySelector('.slider-warning');\n    if (w) w.remove();\n  }\n  var checkNext = function (e) {\n    var btn = e.target.closest && e.target.closest('#NextButton, #next-button, .NextButton');\n    if (!btn) return;\n    var missing = sliderRows.filter(function (r) { return !r.answered(); });\n    if (!missing.length) return;\n    e.preventDefault();\n    e.stopPropagation();   // keeps Qualtrics from moving on; other questions on the page still get checked\n    missing.forEach(function (r) {\n      r.row.classList.add('slider-unanswered');\n      if (!r.row.querySelector('.slider-warning')) {\n        var w = document.createElement('div');\n        w.className = 'slider-warning';\n        w.textContent = WARNING;\n        r.row.appendChild(w);\n      }\n    });\n    if (!e.__sliderScrolled) {\n      e.__sliderScrolled = true;\n      missing[0].row.scrollIntoView({ behavior: 'smooth', block: 'center' });\n    }\n  };\n  document.addEventListener('click', checkNext, true);\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    document.removeEventListener('click', checkNext, true);\n  });\n\n  // Random VISUAL start position per slider. Only the handle is moved; no value is set,\n  // so an untouched slider stays unanswered (Force response still works). The start value\n  // is saved as embedded data \"start_<QID>_<row>\" (declare these fields in the Survey flow).\n  q.querySelectorAll('.track').forEach(function (bar) {\n    var host = bar.parentElement;\n    var handle = host.querySelector('.handle');\n    var fill = host.querySelector('.bar');\n    if (!handle) return;\n    var start = Math.round(Math.random() * 100);\n    var touched = false;\n    var row = bar.closest('.slider-container') || host;\n    var na = row.querySelector('input[type=checkbox]');\n    var rowInfo = { row: row, answered: function () { return touched || (na && na.checked); } };\n    sliderRows.push(rowInfo);\n    var put = function () {\n      if (touched) return;\n      var hw = handle.offsetWidth || 24;\n      var x = start / 100 * (bar.offsetWidth - hw);\n      handle.style.left = x + 'px';\n      if (fill) fill.style.width = x + 'px';\n    };\n    ['mousedown', 'touchstart', 'pointerdown', 'keydown'].forEach(function (ev) {\n      host.addEventListener(ev, function () { touched = true; clearWarning(row); }, true);\n    });\n    if (na) na.addEventListener('change', function () { if (na.checked) clearWarning(row); });\n    put();\n    setTimeout(put, 500);\n    window.addEventListener('resize', function () { setTimeout(put, 150); });\n    var m = (bar.className.match(/(QID\\d+)-(\\d+)-track/) || []);\n    if (m[1]) Qualtrics.SurveyEngine.setEmbeddedData('start_' + m[1] + '_' + m[2], start);\n  });\n\n  // sticky labels header\n  var labels = q.querySelector('.labels-container');\n  if (labels) {\n    var spacer = document.createElement('div');\n    spacer.style.display = 'none';\n    labels.parentNode.insertBefore(spacer, labels);\n    var stuck = false;\n    var sync = function () {\n      var qr = q.getBoundingClientRect();\n      var ref = (stuck ? spacer : labels).getBoundingClientRect();\n      var should = ref.top < 0 && qr.bottom > 100;\n      if (should && !stuck) {\n        var r = labels.getBoundingClientRect();\n        spacer.style.height = r.height + 'px';\n        spacer.style.display = 'block';\n        labels.style.cssText += ';position:fixed;top:0;left:' + r.left +\n          'px;width:' + r.width + 'px;background:#fff;z-index:100;';\n        stuck = true;\n      } else if (!should && stuck) {\n        ['position', 'top', 'left', 'width', 'zIndex'].forEach(function (p) {\n          labels.style[p] = '';\n        });\n        spacer.style.display = 'none';\n        stuck = false;\n      }\n    };\n    window.addEventListener('scroll', sync);\n    window.addEventListener('resize', sync);\n    sync();\n  }\n\n  // icons at each scale point; size scales with slider width\n  var place = function () {\n    q.querySelectorAll('.track').forEach(function (bar) {\n      var host = bar.parentElement;\n      host.querySelectorAll('.tick-emoji').forEach(function (e) { e.remove(); });\n      host.style.position = 'relative';\n\n      // let the edge icons stick out past the slider without being clipped\n      // (only containers that hide overflow; scrolling containers are left alone)\n      for (var el = host; el && el !== document.body; el = el.parentElement) {\n        var cs = getComputedStyle(el);\n        if (/auto|scroll/.test(cs.overflowX + cs.overflowY)) {\n          // scrolling container (needed on mobile): give it room for half an icon on each side\n          el.style.paddingLeft = el.style.paddingRight = '18px';\n          break;\n        }\n        if (/hidden|clip/.test(cs.overflowX + cs.overflowY)) el.style.overflow = 'visible';\n        if (cs.clipPath !== 'none') el.style.clipPath = 'none';\n        if (/paint|strict|content/.test(cs.contain)) el.style.contain = 'none';\n      }\n\n      var knob = host.querySelector('.handle, .ui-slider-handle, [class*=\"handle\"]');\n      // handle width; Qualtrics may hide the handle until first click, so fall back to its CSS width (24px)\n      var hw = (knob && (knob.offsetWidth || parseFloat(getComputedStyle(knob).width))) || 24;\n      var n = ORDER.length - 1;\n      var step = (bar.offsetWidth - hw) / n;\n      var size = Math.round(Math.max(16, Math.min(32, step * 0.7)));  // min 16px, max 32px\n\n      host.style.paddingTop = (size + 6) + 'px';\n      var left = bar.offsetLeft, top = bar.offsetTop - size - 4;\n\n      ORDER.forEach(function (name, i) {\n        var img = document.createElement('img');\n        img.className = 'tick-emoji';\n        img.src = EMOJI[name];\n        img.alt = '';\n        img.style.cssText =\n          'position:absolute;pointer-events:none;z-index:5;transform:translateX(-50%);' +\n          'width:' + size + 'px;height:' + size + 'px;' +\n          // position as a share of the bar width, so it stays right if the layout shifts after loading\n          'top:' + top + 'px;left:calc(' + (left + hw / 2) + 'px + (100% - ' + hw + 'px) * ' + (i / n) + ');';\n        host.appendChild(img);\n      });\n    });\n  };\n  place();\n  setTimeout(place, 500);   // redo once the page layout has settled\n  var timer;\n  window.addEventListener('resize', function () {\n    clearTimeout(timer);\n    timer = setTimeout(place, 100);\n  });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {});\n"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID5", "SecondaryAttribute": "Deel 2 – Wat vind jij van drugs en drugsbeleid?   Hieronder staan uitspraken over drugs. Geef bij", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 2 – Wat vind jij van drugs en drugsbeleid?</h3>\n&nbsp;\n\n<p><span style=\"color: rgb(50, 54, 58);\">Hieronder staan uitspraken over drugs. Geef bij elke uitspraak aan of je het ermee eens of oneens bent. Er zijn geen goede of foute antwoorden.</span></p>", "QuestionText_Unsafe": "<h3>Deel 2 &ndash; Opvattingen over drugs en drugsbeleid</h3><p>Geef bij elke uitspraak aan in hoeverre je het ermee eens of oneens bent. Er zijn geen goede of foute antwoorden.</p>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Deel 2 – Wat vind jij van drugs en drugsbeleid?   Hieronder staan uitspraken over drugs. Geef bij...", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Teil 2 &ndash; Ansichten über Drogen und Drogenpolitik</h3><p>Gib bei jeder Aussage an, inwieweit du ihr zustimmst oder nicht zustimmst. Es gibt keine richtigen oder falschen Antworten.</p>"}, "EN-GB": {"QuestionText": "<h3>Part 2 &ndash; Views on drugs and drug policy</h3><p>For each statement, indicate the extent to which you agree or disagree with it. There are no right or wrong answers.</p>"}, "ES": {"QuestionText": "<h3>Parte 2 &ndash; Opiniones sobre las drogas y la política de drogas</h3><p>Indica para cada afirmación en qué medida estás de acuerdo o en desacuerdo con ella. No hay respuestas correctas o incorrectas.</p>"}, "ES-ES": {"QuestionText": "<h3>Parte 2 &ndash; Opiniones sobre las drogas y la política de drogas</h3><p>Indica para cada afirmación en qué medida estás de acuerdo o en desacuerdo con ella. No hay respuestas correctas o incorrectas.</p>"}, "FR": {"QuestionText": "<h3>Partie 2 &ndash; Opinions sur les drogues et la politique des drogues</h3><p>Pour chaque affirmation, indiquez dans quelle mesure vous êtes d’accord ou non. Il n’y a pas de bonnes ou de mauvaises réponses.</p>"}, "IT": {"QuestionText": "<h3>Parte 2 &ndash; Opinioni su droghe e politica sulle droghe</h3><p>Per ciascuna affermazione, indica in che misura sei d’accordo o in disaccordo. Non ci sono risposte giuste o sbagliate.</p>"}, "PT": {"QuestionText": "<h3>Parte 2 &ndash; Opiniões sobre drogas e política de drogas</h3><p>Para cada afirmação, indique em que medida concorda ou discorda. Não há respostas certas ou erradas.</p>"}, "PT-BR": {"QuestionText": "<h3>Parte 2 &ndash; Opiniões sobre drogas e política de drogas</h3><p>Para cada afirmação, indique em que medida você concorda ou discorda. Não há respostas certas ou erradas.</p>"}}, "QuestionID": "QID5", "DataExportTag": "beliefs_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID6", "SecondaryAttribute": "Click to write the question text", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click to write the question text", "QuestionText_Unsafe": "In hoeverre ben je het eens met de volgende uitspraken?", "QuestionType": "Matrix", "Selector": "Likert", "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "MobileFirst": true, "WhiteSpace": "OFF"}, "QuestionDescription": "Click to write the question text", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "Inwieweit stimmst du den folgenden Aussagen zu?", "Choices": {"1": {"Display": "Die Regulierung derzeit verbotener Substanzen wird die Kriminalität in meinem Land verringern"}, "2": {"Display": "Wenn wir das Verbot bestimmter Substanzen aufheben, nimmt der Missbrauch dieser Substanzen zu"}, "4": {"Display": "Menschen sollten selbst entscheiden dürfen, ungesunde Substanzen zu nehmen"}}, "Answers": {"1": {"Display": "Stimme gar nicht zu"}, "2": {"Display": "Stimme nicht zu"}, "3": {"Display": "Stimme eher nicht zu"}, "4": {"Display": "Neutral"}, "5": {"Display": "Stimme eher zu"}, "6": {"Display": "Stimme zu"}, "7": {"Display": "Stimme voll zu"}}}, "EN-GB": {"QuestionText": "To what extent do you agree with the following statements?", "Choices": {"1": {"Display": "Regulating currently prohibited substances will reduce crime in my country"}, "2": {"Display": "If we lift the ban on certain substances, abuse of these substances will increase"}, "4": {"Display": "People should be allowed to decide for themselves to take unhealthy substances"}}, "Answers": {"1": {"Display": "Strongly disagree"}, "2": {"Display": "Disagree"}, "3": {"Display": "Somewhat disagree"}, "4": {"Display": "Neutral"}, "5": {"Display": "Somewhat agree"}, "6": {"Display": "Agree"}, "7": {"Display": "Strongly agree"}}}, "ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "La regulación de sustancias actualmente prohibidas reducirá la criminalidad en mi país"}, "2": {"Display": "Si levantamos la prohibición de ciertas sustancias, aumentará el abuso de estas sustancias"}, "4": {"Display": "Las personas deberían poder decidir por sí mismas tomar sustancias poco saludables"}}, "Answers": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "ES-ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "La regulación de sustancias actualmente prohibidas reducirá la criminalidad en mi país"}, "2": {"Display": "Si levantamos la prohibición de ciertas sustancias, aumentará el abuso de estas sustancias"}, "4": {"Display": "Las personas deberían poder decidir por sí mismas tomar sustancias poco saludables"}}, "Answers": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "FR": {"QuestionText": "Dans quelle mesure êtes-vous d’accord avec les affirmations suivantes ?", "Choices": {"1": {"Display": "La réglementation des substances actuellement interdites réduira la criminalité dans mon pays"}, "2": {"Display": "Si nous levons l’interdiction de certaines substances, l’abus de ces substances augmentera"}, "4": {"Display": "Les gens devraient pouvoir décider eux-mêmes de prendre des substances mauvaises pour la santé"}}, "Answers": {"1": {"Display": "Pas du tout d’accord"}, "2": {"Display": "Pas d’accord"}, "3": {"Display": "Plutôt pas d’accord"}, "4": {"Display": "Neutre"}, "5": {"Display": "Plutôt d’accord"}, "6": {"Display": "D’accord"}, "7": {"Display": "Tout à fait d’accord"}}}, "IT": {"QuestionText": "In che misura sei d’accordo con le seguenti affermazioni?", "Choices": {"1": {"Display": "La regolamentazione delle sostanze attualmente vietate ridurrà la criminalità nel mio paese"}, "2": {"Display": "Se aboliamo il divieto su determinate sostanze, l’abuso di queste sostanze aumenterà"}, "4": {"Display": "Le persone dovrebbero poter decidere da sole di assumere sostanze poco salutari"}}, "Answers": {"1": {"Display": "Molto in disaccordo"}, "2": {"Display": "In disaccordo"}, "3": {"Display": "Un po’ in disaccordo"}, "4": {"Display": "Neutrale"}, "5": {"Display": "Un po’ d’accordo"}, "6": {"Display": "D’accordo"}, "7": {"Display": "Molto d’accordo"}}}, "PT": {"QuestionText": "Em que medida concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "A regulação de substâncias atualmente proibidas reduzirá a criminalidade no meu país"}, "2": {"Display": "Se levantarmos a proibição de certas substâncias, o abuso dessas substâncias aumentará"}, "4": {"Display": "As pessoas deveriam poder decidir por si mesmas tomar substâncias pouco saudáveis"}}, "Answers": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}, "PT-BR": {"QuestionText": "Em que medida você concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "A regulação de substâncias atualmente proibidas reduzirá a criminalidade no meu país"}, "2": {"Display": "Se levantarmos a proibição de certas substâncias, o abuso dessas substâncias aumentará"}, "4": {"Display": "As pessoas deveriam poder decidir por si mesmas tomar substâncias pouco saudáveis"}}, "Answers": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}}, "QuestionID": "QID6", "DataExportTag": "beliefs_society", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 22, "NextAnswerId": 8, "SubSelector": "SingleAnswer", "Choices": {"1": {"Display": "Mensen mogen zelf beslissen of ze schadelijke middelen gebruiken."}, "2": {"Display": "Drugsgebruik is slecht voor de normen en waarden van onze samenleving."}, "4": {"Display": "Nederland moet zich houden aan het internationale verbod op drugs."}, "20": {"Display": "Het is verkeerd om geld te verdienen aan middelen waar mensen verslaafd aan kunnen raken."}, "21": {"Display": "We streven naar een samenleving waarin niemand verslavende middelen gebruikt."}}, "ChoiceOrder": [1, 2, 4, "20", "21"], "Answers": {"1": {"Display": "Helemaal mee oneens"}, "2": {"Display": "Mee oneens"}, "3": {"Display": "Enigszins mee oneens"}, "4": {"Display": "Neutraal"}, "5": {"Display": "Enigszins mee eens"}, "6": {"Display": "Mee eens"}, "7": {"Display": "Helemaal mee eens"}}, "AnswerOrder": ["1", "2", "3", "4", "5", "6", "7"], "ChoiceDataExportTags": false, "Randomization": {"Advanced": null, "TotalRandSubset": "", "Type": "All"}, "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n  var t = this.getQuestionContainer().querySelector('.QuestionText');\n  if (t) t.style.display = 'none';\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t/*Place your JavaScript here to run when the page is fully displayed*/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t/*Place your JavaScript here to run when the page is unloaded*/\n\n});"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID7", "SecondaryAttribute": "Deel 3 – Gedrag De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die..", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 3 – Gedrag</h3>\n\n<p>De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die bij jou past.</p>", "QuestionText_Unsafe": "<h3>Deel 3 &ndash; Gedrag</h3><p>De volgende uitspraken gaan over jouw gedrag en dat van mensen om je heen. Geef opnieuw aan in hoeverre je het ermee eens bent. Je antwoorden zijn anoniem.</p>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Deel 3 – Gedrag De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die...", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "<h3>Teil 3 &ndash; Verhalten</h3><p>Die folgenden Aussagen betreffen dein Verhalten und das der Menschen um dich herum. Gib erneut an, inwieweit du zustimmst. Deine Antworten sind anonym.</p>"}, "EN-GB": {"QuestionText": "<h3>Part 3 &ndash; Behaviour</h3><p>The following statements are about your behaviour and that of the people around you. Again, indicate the extent to which you agree. Your answers are anonymous.</p>"}, "ES": {"QuestionText": "<h3>Parte 3 &ndash; Comportamiento</h3><p>Las siguientes afirmaciones tratan sobre tu comportamiento y el de las personas a tu alrededor. Indica de nuevo en qué medida estás de acuerdo. Tus respuestas son anónimas.</p>"}, "ES-ES": {"QuestionText": "<h3>Parte 3 &ndash; Comportamiento</h3><p>Las siguientes afirmaciones tratan sobre tu comportamiento y el de las personas a tu alrededor. Indica de nuevo en qué medida estás de acuerdo. Tus respuestas son anónimas.</p>"}, "FR": {"QuestionText": "<h3>Partie 3 &ndash; Comportement</h3><p>Les affirmations suivantes portent sur votre comportement et celui des personnes qui vous entourent. Indiquez à nouveau dans quelle mesure vous êtes d’accord. Vos réponses sont anonymes.</p>"}, "IT": {"QuestionText": "<h3>Parte 3 &ndash; Comportamento</h3><p>Le affermazioni seguenti riguardano il tuo comportamento e quello delle persone intorno a te. Indica di nuovo in che misura sei d’accordo. Le tue risposte sono anonime.</p>"}, "PT": {"QuestionText": "<h3>Parte 3 &ndash; Comportamento</h3><p>As afirmações seguintes são sobre o seu comportamento e o das pessoas à sua volta. Indique novamente em que medida concorda. As suas respostas são anónimas.</p>"}, "PT-BR": {"QuestionText": "<h3>Parte 3 &ndash; Comportamento</h3><p>As afirmações a seguir são sobre o seu comportamento e o das pessoas ao seu redor. Indique novamente em que medida você concorda. Suas respostas são anônimas.</p>"}}, "QuestionID": "QID7", "DataExportTag": "gedrag_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID8", "SecondaryAttribute": "Deel 3 – Gedrag De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die..", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h3>Deel 3 – Gedrag</h3><div><br></div>De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die bij jou past.", "QuestionText_Unsafe": "In hoeverre ben je het eens met de volgende uitspraken?", "QuestionType": "Matrix", "Selector": "Likert", "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "inline", "ChoiceColumnWidth": 25, "RepeatHeaders": "none", "WhiteSpace": "ON", "MobileFirst": true}, "QuestionDescription": "Deel 3 – Gedrag De volgende uitspraken gaan over jouw gedrag. Geef bij elke uitspraak aan of die...", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "Language": {"DE": {"QuestionText": "Inwieweit stimmst du den folgenden Aussagen zu?", "Choices": {"1": {"Display": "Ich meide Drogenkonsumenten"}, "3": {"Display": "Ich halte mich an Regeln"}, "4": {"Display": "Ich experimentiere gern"}}, "Answers": {"1": {"Display": "Stimme gar nicht zu"}, "2": {"Display": "Stimme nicht zu"}, "3": {"Display": "Stimme eher nicht zu"}, "4": {"Display": "Neutral"}, "5": {"Display": "Stimme eher zu"}, "6": {"Display": "Stimme zu"}, "7": {"Display": "Stimme voll zu"}}}, "EN-GB": {"QuestionText": "To what extent do you agree with the following statements?", "Choices": {"1": {"Display": "I avoid drug users"}, "3": {"Display": "I follow rules"}, "4": {"Display": "I like to experiment"}}, "Answers": {"1": {"Display": "Strongly disagree"}, "2": {"Display": "Disagree"}, "3": {"Display": "Somewhat disagree"}, "4": {"Display": "Neutral"}, "5": {"Display": "Somewhat agree"}, "6": {"Display": "Agree"}, "7": {"Display": "Strongly agree"}}}, "ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "Evito a los consumidores de drogas"}, "3": {"Display": "Sigo las reglas"}, "4": {"Display": "Me gusta experimentar"}}, "Answers": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "ES-ES": {"QuestionText": "¿En qué medida estás de acuerdo con las siguientes afirmaciones?", "Choices": {"1": {"Display": "Evito a los consumidores de drogas"}, "3": {"Display": "Cumplo las normas"}, "4": {"Display": "Me gusta experimentar"}}, "Answers": {"1": {"Display": "Muy en desacuerdo"}, "2": {"Display": "En desacuerdo"}, "3": {"Display": "Algo en desacuerdo"}, "4": {"Display": "Neutral"}, "5": {"Display": "Algo de acuerdo"}, "6": {"Display": "De acuerdo"}, "7": {"Display": "Muy de acuerdo"}}}, "FR": {"QuestionText": "Dans quelle mesure êtes-vous d’accord avec les affirmations suivantes ?", "Choices": {"1": {"Display": "J’évite les consommateurs de drogues"}, "3": {"Display": "Je respecte les règles"}, "4": {"Display": "J’aime expérimenter"}}, "Answers": {"1": {"Display": "Pas du tout d’accord"}, "2": {"Display": "Pas d’accord"}, "3": {"Display": "Plutôt pas d’accord"}, "4": {"Display": "Neutre"}, "5": {"Display": "Plutôt d’accord"}, "6": {"Display": "D’accord"}, "7": {"Display": "Tout à fait d’accord"}}}, "IT": {"QuestionText": "In che misura sei d’accordo con le seguenti affermazioni?", "Choices": {"1": {"Display": "Evito i consumatori di droghe"}, "3": {"Display": "Rispetto le regole"}, "4": {"Display": "Mi piace sperimentare"}}, "Answers": {"1": {"Display": "Molto in disaccordo"}, "2": {"Display": "In disaccordo"}, "3": {"Display": "Un po’ in disaccordo"}, "4": {"Display": "Neutrale"}, "5": {"Display": "Un po’ d’accordo"}, "6": {"Display": "D’accordo"}, "7": {"Display": "Molto d’accordo"}}}, "PT": {"QuestionText": "Em que medida concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "Evito consumidores de drogas"}, "3": {"Display": "Sigo as regras"}, "4": {"Display": "Gosto de experimentar"}}, "Answers": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}, "PT-BR": {"QuestionText": "Em que medida você concorda com as seguintes afirmações?", "Choices": {"1": {"Display": "Evito usuários de drogas"}, "3": {"Display": "Sigo as regras"}, "4": {"Display": "Gosto de experimentar"}}, "Answers": {"1": {"Display": "Discordo totalmente"}, "2": {"Display": "Discordo"}, "3": {"Display": "Discordo um pouco"}, "4": {"Display": "Neutro"}, "5": {"Display": "Concordo um pouco"}, "6": {"Display": "Concordo"}, "7": {"Display": "Concordo totalmente"}}}}, "QuestionID": "QID8", "DataExportTag": "gedrag_beleid", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 5, "NextAnswerId": 8, "SubSelector": "SingleAnswer", "Choices": {"1": {"Display": "Ik zou drugsdealers altijd melden bij de politie."}, "3": {"Display": "Ik vermijd drugsgebruikers"}, "4": {"Display": "Als iemand een drug heeft gebruikt die ik niet ken, zou ik ernaar vragen."}}, "ChoiceOrder": [1, 3, 4], "Answers": {"1": {"Display": "Helemaal mee oneens"}, "2": {"Display": "Mee oneens"}, "3": {"Display": "Enigszins mee oneens"}, "4": {"Display": "Neutraal"}, "5": {"Display": "Enigszins mee eens"}, "6": {"Display": "Mee eens"}, "7": {"Display": "Helemaal mee eens"}}, "AnswerOrder": ["1", "2", "3", "4", "5", "6", "7"], "ChoiceDataExportTags": false, "Randomization": {"Advanced": null, "TotalRandSubset": "", "Type": "All"}, "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function()\n{\n\t  var t = this.getQuestionContainer().querySelector('.QuestionText');\n  if (t) t.style.display = 'none';\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t/*Place your JavaScript here to run when the page is fully displayed*/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t/*Place your JavaScript here to run when the page is unloaded*/\n\n});"}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "SQ", "PrimaryAttribute": "QID9", "SecondaryAttribute": "De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je...", "TertiaryAttribute": null, "Payload": {"QuestionText": "De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je mag een vraag ook overslaan.", "QuestionText_Unsafe": "<h4>Eigen middelengebruik</h4><p>De volgende vragen gaan over je eigen gebruik van middelen. Je antwoorden zijn volledig anoniem en je bent nooit verplicht te antwoorden. We onderscheiden drie categorie&euml;n:</p><ul style='line-height:1.5'><li><b>Legale drugs</b>: alcohol, tabak, cafeïne.</li><li><b>Lijst 1 (harddrugs)</b>: bijv. heroïne, cocaïne, XTC/MDMA, amfetamine (speed), GHB, LSD.</li><li><b>Lijst 2 (softdrugs)</b>: bijv. cannabis (wiet, hasj), paddo’s.</li></ul>", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "De volgende vragen gaan over je eigen gebruik van drugs. Je antwoorden zijn volledig anoniem. Je...", "Validation": {"Settings": {"Type": "None"}}, "Language": {"DE": {"QuestionText": "Die folgenden Fragen betreffen deinen eigenen Konsum von Substanzen. Deine Antworten sind völlig anonym. Du kannst eine Frage auch überspringen."}, "EN-GB": {"QuestionText": "The following questions are about your own use of substances. Your answers are completely anonymous. You may also skip a question."}, "ES": {"QuestionText": "Las siguientes preguntas tratan sobre tu propio consumo de sustancias. Tus respuestas son completamente anónimas. También puedes saltarte una pregunta."}, "ES-ES": {"QuestionText": "Las siguientes preguntas tratan sobre tu propio consumo de sustancias. Tus respuestas son completamente anónimas. También puedes saltarte una pregunta."}, "FR": {"QuestionText": "Les questions suivantes portent sur votre propre consommation de substances. Vos réponses sont entièrement anonymes. Vous pouvez aussi passer une question."}, "IT": {"QuestionText": "Le prossime domande riguardano il tuo consumo personale di sostanze. Le tue risposte sono completamente anonime. Puoi anche saltare una domanda."}, "PT": {"QuestionText": "As perguntas seguintes são sobre o seu próprio uso de substâncias. As suas respostas são completamente anónimas. Também pode saltar uma pergunta."}, "PT-BR": {"QuestionText": "As próximas perguntas são sobre o seu próprio uso de substâncias. Suas respostas são completamente anônimas. Você também pode pular uma pergunta."}}, "QuestionID": "QID9", "DataExportTag": "gebruik_intro", "DefaultChoices": false, "DataVisibility": {"Private": false, "Hidden": false}, "GradingData": [], "NextChoiceId": 1, "NextAnswerId": 1, "ChoiceOrder": []}}, {"SurveyID": "SV_73amD37tHZ2Qe9w", "Element": "STAT", "PrimaryAttribute": "Survey Statistics", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"MobileCompatible": false, "ID": "Survey Statistics"}}]}